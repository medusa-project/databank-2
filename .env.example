# Copy to .env and adjust for your local/test environment.
# This project does not require copying binaries during metadata migration.
# Keep storage_root/storage_key from legacy records unchanged.

# --- Medusa storage root-set config (used by config/medusa-storage-ci.yml) ---
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_ACCESS_KEY_ID=minioadmin
STORAGE_S3_SECRET_ACCESS_KEY=minioadmin
STORAGE_S3_REGION=us-east-2

# Buckets/prefixes should match the layout used by legacy records you import.
STORAGE_DRAFT_BUCKET=databank-local-main
STORAGE_DRAFT_PREFIX=uploads/
STORAGE_MEDUSA_BUCKET=medusa-local-main
STORAGE_MEDUSA_PREFIX=
STORAGE_GLOBUS_BUCKET=globus-local-download
STORAGE_GLOBUS_DOWNLOAD_PREFIX=download/
STORAGE_TMPFS_PATH=/tmp
STORAGE_TMPDIR=/tmp

# --- Optional sample-import fallback depositor identity ---
MIGRATION_SAMPLE_OWNER_UID=legacy-import
MIGRATION_SAMPLE_DEPOSITOR_NAME=Legacy Import
MIGRATION_SAMPLE_DEPOSITOR_EMAIL=legacy-import@example.edu
