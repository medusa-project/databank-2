# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*
!/.env.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key
/config/credentials/*.key

/app/assets/builds/*
!/app/assets/builds/.keep

# JavaScript dependencies and test artifacts
/node_modules/
/test-results/
/playwright-report/
/coverage/

# Ignore local working files
/working/*
!/working/.keep
/migration_bundles/*
!/migration_bundles/.keep
!/migration_bundles/datasets/.keep
!/migration_bundles/guides/.keep
!/migration_bundles/featured_researchers/.keep

# Generated metrics export artifacts
/public/archive_file_contents.csv
/public/datafile_downloads.json
/public/datafiles.csv
/public/dataset_downloads.json
/public/dataset_downloads_totals.csv
/public/datasets.tsv
/public/funders.csv
/public/related_materials.csv
