- content_for :title, @dataset.title

- doi_url = dataset_persistent_url(@dataset)
- citation_text = dataset_plain_text_citation(@dataset)
- primary_contact_name = dataset_primary_contact_name(@dataset)
- version_related_materials = @dataset.version_related_materials
- nonversion_related_materials = @dataset.nonversion_related_materials
- related_materials = nonversion_related_materials.reject { |material| material.relation_type == "IsCitedBy" }
- cited_by_materials = nonversion_related_materials.select { |material| material.relation_type == "IsCitedBy" }
- additional_contacts = @dataset.contributors.map(&:name).reject(&:blank?)
- download_count = @dataset.respond_to?(:total_downloads) ? @dataset.total_downloads.to_i : 0
- previous_version = @dataset.previous_version_dataset
- next_version = @dataset.version_successor
- previous_version_material = @dataset.previous_version_material
- next_version_material = version_related_materials.find { |material| material.relation_type == RelatedMaterial::VERSION_NEW_RELATION }
- previous_version_visible = previous_version if previous_version.present? && can?(:read, previous_version)
- next_version_visible = next_version if next_version.present? && can?(:read, next_version)

%ilw-content.dataset-show-page
  .dataset-show-summary
    - if @version_group.latest_published_version.present? && @version_group.latest_published_version != @dataset
      .dataset-show-status
        %p
          %strong A newer version of this dataset is available.
          = " "
          = link_to "View the latest version.", dataset_path(@version_group.latest_published_version)

    .dataset-show-titlebar
      = render "datasets/workflow/show_actions", dataset: @dataset

    - if citation_text.present? || doi_url.present?
      .dataset-show-citation
        - if citation_text.present?
          .dataset-show-citation-copy
            %p.dataset-show-eyebrow Cite this dataset:
            %p.dataset-show-citation-text= citation_text

        - if doi_url.present?
          .dataset-show-persistent-link
            %label.dataset-show-eyebrow{for: "persistent-url"} Use this persistent URL to link to this dataset:
            .dataset-show-persistent-controls
              %input#persistent-url.datasets-search-input{type: "text", value: doi_url, readonly: true}
              %button.idb-button-primary.dataset-show-copy-button{type: "button", onclick: "navigator.clipboard.writeText(document.getElementById('persistent-url').value).then(function() { var status = document.getElementById('copy-status'); if (status) { status.textContent = 'Persistent URL copied to clipboard.'; } }).catch(function() { var status = document.getElementById('copy-status'); if (status) { status.textContent = 'Unable to copy URL. Please copy manually.'; } });"}
                Copy
              %span#copy-status.sr-only{aria: { live: "polite" }}

    - if logged_in? && can?(:update, @dataset)
      - missing = @dataset.missing_publish_fields
      .dataset-show-status
        - if missing.any?
          %p
            %strong Publish requirements missing:
            = " #{missing.join(', ')}"
        - else
          %p
            %strong This dataset is ready to publish.

        - unless @dataset.published?
          = button_to "Publish", publish_dataset_path(@dataset), method: :post, class: "idb-button-primary"

  .dataset-show-grid
    %section.dataset-show-panel.idb-rounded-section{aria: { label: "Dataset metadata" }}
      %details.idb-section-disclosure.dataset-show-disclosure{open: true}
        %summary
          %h2.dataset-show-section-title Metadata
        .idb-section-body
          %dl.dataset-show-metadata
            - if @dataset.description.present?
              %dt Dataset Description
              %dd= simple_format(@dataset.description)

            - if @dataset.subject.present?
              %dt Subject
              %dd= link_to @dataset.subject, datasets_path(subjects: [@dataset.subject])

            - if @dataset.keywords.present?
              %dt Keywords
              %dd= @dataset.keywords

            - if @dataset.license.present?
              %dt License
              %dd= @dataset.license

            - @dataset.funders.each do |funder|
              %dt Funder
              - funder_bits = [funder.name, funder.identifier.presence, (funder.award_number.present? ? "Award #{funder.award_number}" : nil)].compact
              %dd= funder_bits.join(" | ")

            - if primary_contact_name.present?
              %dt Corresponding Creator
              %dd= primary_contact_name

            - if additional_contacts.any?
              %dt Additional Contact(s)
              %dd= additional_contacts.join("; ")

            - if @dataset.publisher.present?
              %dt Publisher
              %dd= @dataset.publisher

            - if can?(:manage, @dataset)
              %dt Depositor
              %dd= @dataset.depositor_name

              %dt Depositor Email
              %dd= @dataset.depositor_email

            - if download_count.positive?
              %dt Downloaded
              %dd= pluralize(download_count, "time")

            - if related_materials.any?
              %dt.sr-only Related Materials
              %dd.dataset-show-metadata-nested
                %details.idb-section-disclosure.dataset-show-nested-disclosure
                  %summary
                    %span.dataset-show-nested-summary-label
                      %span.dataset-show-nested-title Related Materials
                      %span.dataset-show-badge= related_materials.count
                  .idb-section-body
                    %ul.dataset-show-list
                      - related_materials.each do |material|
                        %li
                          - if material.uri.present?
                            %span.dataset-show-list-primary= link_to material.title, material.uri
                          - else
                            %span.dataset-show-list-primary= material.title
                          - if material.relation_type.present?
                            %span.dataset-show-list-secondary= material.relation_type

            - if cited_by_materials.any?
              %dt.sr-only Cited By
              %dd.dataset-show-metadata-nested
                %details.idb-section-disclosure.dataset-show-nested-disclosure
                  %summary
                    %span.dataset-show-nested-summary-label
                      %span.dataset-show-nested-title Cited By
                      %span.dataset-show-badge= cited_by_materials.count
                  .idb-section-body
                    %ul.dataset-show-list
                      - cited_by_materials.each do |material|
                        %li
                          - if material.uri.present?
                            %span.dataset-show-list-primary= link_to material.title, material.uri
                          - else
                            %span.dataset-show-list-primary= material.title
                          - if material.relation_type.present?
                            %span.dataset-show-list-secondary= material.relation_type

    - visible_version_entries = @version_group.entries.select { |entry| entry[:dataset].published? || can?(:review_versions, @dataset) }
    - if visible_version_entries.any?
      %section.dataset-show-panel.idb-rounded-section{aria: { label: "Versions in Illinois Data Bank" }}
        %details.idb-section-disclosure.dataset-show-disclosure{open: (visible_version_entries.length > 1)}
          %summary
            %h2.dataset-show-section-title= visible_version_entries.length > 1 ? "Versions in Illinois Data Bank" : "Versions"
          .idb-section-body
            .dataset-show-table-wrap
              %table.dataset-show-table
                %thead
                  %tr
                    %th Dataset
                    %th DOI
                    %th State
                %tbody
                  - visible_version_entries.each do |entry|
                    %tr{ class: (entry[:selected] ? "dataset-show-version-selected" : nil) }
                      %td= link_to "#{entry[:title]} (#{entry[:key]})", dataset_path(entry[:dataset])
                      %td
                        - if entry[:doi].present?
                          = link_to entry[:doi], "https://doi.org/#{entry[:doi]}"
                        - else
                          not yet set
                      %td= entry[:publication_state].to_s

    - if @dataset.datafiles.any?
      %section.dataset-show-panel.idb-rounded-section{aria: { label: "Files" }}
        %details.idb-section-disclosure.dataset-show-disclosure{open: true}
          %summary
            %h2.dataset-show-section-title Files
          .idb-section-body
            %ul.dataset-show-file-list
              - @dataset.datafiles.each do |datafile|
                - file_size = datafile.binary.attached? ? datafile.binary.byte_size : datafile.binary_size
                %li
                  .dataset-show-file-row
                    %span.dataset-show-list-primary.dataset-show-file-name= datafile.binary_name.presence || datafile.web_id
                    %span.dataset-show-list-secondary.dataset-show-file-size= file_size.present? ? number_to_human_size(file_size) : "-"
                    - if can?(:read, @dataset)
                      %span.dataset-show-download.dataset-show-download-cell= link_to "Download", download_dataset_datafile_path(@dataset, datafile), class: "idb-button-primary dataset-show-download-button"
                  - if datafile.description.present?
                    %span.dataset-show-list-tertiary.dataset-show-file-description= datafile.description

    %section.dataset-show-panel.idb-rounded-section{aria: { label: "Change log" }}
      %details.idb-section-disclosure.dataset-show-disclosure
        %summary
          %h2.dataset-show-section-title Change Log
        .idb-section-body
          - if @version_request_history.present?
            %ul.dataset-show-list
              - @version_request_history.each do |request|
                %li
                  %span.dataset-show-list-primary= "#{request.status.titleize} request from #{request.requester_name}"
                  %span.dataset-show-list-secondary= "Submitted #{request.requested_at.utc.iso8601}"
                  - if request.comment.present?
                    %span.dataset-show-list-tertiary= request.comment
                  - if request.reviewed_at.present?
                    %span.dataset-show-list-tertiary= "Reviewed #{request.reviewed_at.utc.iso8601}"
                  - if request.review_note.present?
                    %span.dataset-show-list-tertiary= "Review note: #{request.review_note}"
                  - if request.approved_dataset.present?
                    %span.dataset-show-list-tertiary= link_to("Draft created: #{request.approved_dataset.key}", edit_dataset_path(request.approved_dataset))
          - else
            .dataset-show-table-wrap
              %p
                No change log entries available.

  - if logged_in? && can?(:review_versions, @dataset)
    %section.dataset-show-panel.idb-rounded-section{aria: { label: "Curator controls" }}
      %details.idb-section-disclosure.dataset-show-disclosure{open: true}
        %summary
          %h2.dataset-show-section-title Curator Controls
        .idb-section-body
          %p
            = link_to "Version Controls", version_controls_dataset_path(@dataset), class: "idb-button-primary"
          %p
            = link_to "Curator Notes", dataset_notes_path(@dataset), class: "idb-button-secondary"

  - if logged_in? && can?(:manage, Dataset)
    %section.dataset-show-panel.idb-rounded-section{aria: { label: "External delivery" }}
      %details.idb-section-disclosure.dataset-show-disclosure{open: true}
        %summary
          %h2.dataset-show-section-title External Delivery
        .idb-section-body
          %p
            = link_to "View Delivery Audit", admin_external_delivery_attempts_path(dataset_key: @dataset.key), class: "idb-button-primary"

          - if @latest_delivery_attempts.present?
            %ul.dataset-show-list
              - @latest_delivery_attempts.each do |integration, attempt|
                %li
                  %span.dataset-show-list-primary= "#{integration}: #{attempt.status}"
                  %span.dataset-show-list-secondary= "Attempt #{attempt.attempt} at #{attempt.created_at.utc.iso8601}"
                  - if attempt.error_message.present?
                    %span.dataset-show-list-tertiary= attempt.error_message
          - else
            %p
              No external delivery attempts recorded yet.

          - total_failed = @failed_delivery_counts.values.sum
          - if total_failed.positive?
            %p
              Failed attempts:
              = total_failed
            %p
              = button_to "Replay All Failed Deliveries", replay_failed_deliveries_dataset_path(@dataset, integration: "all"), method: :post, class: "idb-button-primary"
            - @failed_delivery_counts.each do |integration, count|
              %p
                = "#{integration} failures: #{count}"
                = button_to "Replay #{integration} Failures", replay_failed_deliveries_dataset_path(@dataset, integration: integration), method: :post, class: "idb-button-primary"
