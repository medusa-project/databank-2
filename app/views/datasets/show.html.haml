- content_for :title, @dataset.title

- doi_url = dataset_persistent_url(@dataset)
- citation_text = dataset_plain_text_citation(@dataset)
- primary_contact_name = dataset_primary_contact_name(@dataset)
- version_related_materials = @dataset.version_related_materials
- nonversion_related_materials = @dataset.nonversion_related_materials
- related_materials = nonversion_related_materials.reject { |material| material.relation_types.include?("IsCitedBy") }
- cited_by_materials = nonversion_related_materials.select { |material| material.relation_types.include?("IsCitedBy") }
- additional_contacts = @dataset.contributors.map(&:name).reject(&:blank?)
- download_count = @dataset.respond_to?(:total_downloads) ? @dataset.total_downloads.to_i : 0
- previous_version = @dataset.previous_version_dataset
- next_version = @dataset.version_successor
- previous_version_material = @dataset.previous_version_material
- next_version_material = version_related_materials.find { |material| material.relation_type == RelatedMaterial::VERSION_NEW_RELATION }
- previous_version_visible = previous_version if previous_version.present? && can?(:read, previous_version)
- next_version_visible = next_version if next_version.present? && can?(:read, next_version)
- datafiles = @dataset.datafiles
- datafile_count = datafiles.length
- show_bulk_file_actions = can?(:view_files, @dataset) && datafile_count > 1 && @dataset_aggregate_downloadable

%ilw-content.dataset-show-page
  .dataset-show-summary
    - if @version_group.latest_published_version.present? && @version_group.latest_published_version != @dataset
      .dataset-show-status
        %p
          %strong A newer version of this dataset is available.
          = " "
          = link_to "View the latest version.", dataset_path(@version_group.latest_published_version)

    .dataset-show-titlebar
      = render "datasets/workflow/show_actions", dataset: @dataset
    - if citation_text.present? || doi_url.present?
      .dataset-show-citation
        - if citation_text.present?
          .dataset-show-citation-copy
            %p.dataset-show-eyebrow Cite this dataset:
            %p.dataset-show-citation-text= citation_text

        - if doi_url.present?
          .dataset-show-persistent-link
            %label.dataset-show-eyebrow{for: "persistent-url"} Use this persistent URL to link to this dataset:
            .dataset-show-persistent-controls
              %input#persistent-url.datasets-search-input{type: "text", value: doi_url, readonly: true}
              = semantic_action_button(action: :copy, style: :idb, icon_only: true, aria_label: "Copy persistent URL to clipboard", class: "dataset-show-copy-button", onclick: "navigator.clipboard.writeText(document.getElementById('persistent-url').value).then(function() { var status = document.getElementById('copy-status'); if (status) { status.textContent = 'Persistent URL copied to clipboard.'; } }).catch(function() { var status = document.getElementById('copy-status'); if (status) { status.textContent = 'Unable to copy URL. Please copy manually.'; } });")
              %span#copy-status.sr-only{aria: { live: "polite" }}

    - if logged_in? && can?(:update, @dataset)
      - missing = @dataset.missing_publish_fields
      .dataset-show-status
        - if missing.any?
          %p
            %strong Publish requirements missing:
            = " #{missing.join(', ')}"
        - else
          %p
            %strong This dataset is ready to publish.

        - unless @dataset.published?
          = button_to "Request Pre-Publication Review", request_review_dataset_path(@dataset), method: :post, class: "idb-button-secondary"
          = button_to "Publish", publish_dataset_path(@dataset), method: :post, class: "idb-button-primary"

  .dataset-show-grid
    %section.idb-section-card{aria: { label: "Dataset metadata" }}
      %details.idb-section-disclosure{open: true}
        %summary
          %h2.idb-section-title Metadata
        .idb-section-body
          %dl.dataset-show-metadata
            - if @dataset.description.present?
              %dt Dataset Description
              %dd= simple_format(@dataset.description)

            - if @dataset.subject.present?
              %dt Subject
              %dd= link_to @dataset.subject, datasets_path(subjects: [@dataset.subject])

            - if @dataset.keywords.present?
              %dt Keywords
              %dd= @dataset.keywords

            - if @dataset.license.present?
              %dt License
              %dd= @dataset.license

            - @dataset.funders.each do |funder|
              %dt Funder
              - funder_bits = [funder.name, funder.identifier.presence, (funder.award_number.present? ? "Award #{funder.award_number}" : nil)].compact
              %dd= funder_bits.join(" | ")

            - if primary_contact_name.present?
              %dt Corresponding Creator
              %dd= primary_contact_name

            - if additional_contacts.any?
              %dt Additional Contact(s)
              %dd= additional_contacts.join("; ")

            - if @dataset.publisher.present?
              %dt Publisher
              %dd= @dataset.publisher

            - if can?(:manage, @dataset)
              %dt Depositor
              %dd= @dataset.depositor_name

              %dt Depositor Email
              %dd= @dataset.depositor_email

            - if download_count.positive?
              %dt Downloaded
              %dd= pluralize(download_count, "time")

            - if related_materials.any?
              %dt.sr-only Related Materials
              %dd.dataset-show-metadata-nested
                %details.idb-section-disclosure.dataset-show-nested-disclosure
                  %summary
                    %span.dataset-show-nested-summary-label
                      %span.dataset-show-nested-title Related Materials
                      = semantic_count_badge(count: related_materials.count, label: nil, sr_label: "Related materials count")
                  .idb-section-body
                    %ul.dataset-show-list
                      - related_materials.each do |material|
                        %li
                          - if material.uri.present?
                            %span.dataset-show-list-primary= link_to material.title, material.uri
                          - else
                            %span.dataset-show-list-primary= material.title
                          - if material.selected_type.present?
                            %span.dataset-show-list-secondary= "Type: #{material.selected_type}"
                          - if material.relation_types.any?
                            %span.dataset-show-list-secondary= "Relations: #{material.relation_types.join(', ')}"
                          - if material.note.present?
                            %span.dataset-show-list-tertiary= "Note: #{material.note}"

            - if cited_by_materials.any?
              %dt.sr-only Cited By
              %dd.dataset-show-metadata-nested
                %details.idb-section-disclosure.dataset-show-nested-disclosure
                  %summary
                    %span.dataset-show-nested-summary-label
                      %span.dataset-show-nested-title Cited By
                      = semantic_count_badge(count: cited_by_materials.count, label: nil, sr_label: "Cited by count")
                  .idb-section-body
                    %ul.dataset-show-list
                      - cited_by_materials.each do |material|
                        %li
                          - if material.uri.present?
                            %span.dataset-show-list-primary= link_to material.title, material.uri
                          - else
                            %span.dataset-show-list-primary= material.title
                          - if material.selected_type.present?
                            %span.dataset-show-list-secondary= "Type: #{material.selected_type}"
                          - if material.relation_types.any?
                            %span.dataset-show-list-secondary= "Relations: #{material.relation_types.join(', ')}"
                          - if material.note.present?
                            %span.dataset-show-list-tertiary= "Note: #{material.note}"

    - visible_version_entries = @version_group.entries.select { |entry| entry[:dataset].published? || can?(:review_versions, @dataset) }
    - if visible_version_entries.any?
      %section.idb-section-card{aria: { label: "Versions in Illinois Data Bank" }}
        %details.idb-section-disclosure{open: (visible_version_entries.length > 1)}
          %summary
            %h2.idb-section-title= visible_version_entries.length > 1 ? "Versions in Illinois Data Bank" : "Versions"
          .idb-section-body
            .dataset-show-table-wrap
              %table.dataset-show-table
                %thead
                  %tr
                    %th Dataset
                    %th DOI
                    %th State
                %tbody
                  - visible_version_entries.each do |entry|
                    %tr{ class: (entry[:selected] ? "dataset-show-version-selected" : nil) }
                      %td= link_to "#{entry[:title]} (#{entry[:key]})", dataset_path(entry[:dataset])
                      %td
                        - if entry[:doi].present?
                          = link_to entry[:doi], "https://doi.org/#{entry[:doi]}"
                        - else
                          not yet set
                      %td= semantic_status_badge(status: entry[:publication_state].to_s, sr_label: "Publication state #{entry[:publication_state]}")

    - if datafile_count.positive? || @dataset.external_files?
      %section.idb-section-card{aria: { label: "Files" }}
        %details.idb-section-disclosure{open: true}
          %summary
            - if @dataset.external_files?
              %h2.idb-section-title Files - Subset
            - else
              %h2.idb-section-title Files
          .idb-section-body
            - if @dataset.external_files?
              = render "show_external_files", dataset: @dataset

            = render "file_restriction_alert", dataset: @dataset
            = render "globus_delay_alert", dataset: @dataset
            
            - if show_bulk_file_actions
              .dataset-files-controls
                %form#custom-download-form{data: {controller: "custom-downloader"}, style: "margin: 0"}
                  .dataset-files-controls-row
                    .dataset-files-controls-left
                      %label.dataset-select-all-label
                        %input#checkAllFiles{type: "checkbox", data: {action: "custom-downloader#toggleSelectAll"}, aria: {label: "Select all files"}}
                        %span Select all
                    .dataset-files-controls-center
                      %button.idb-button-primary{type: "button", data: {action: "custom-downloader#requestDownload"}, id: "request-download-button", disabled: true, aria: {label: "Create a custom zip file with selected files from this dataset"}}
                        %span Get Custom Zip and Download Link for Selected
                        %span#custom-download-count (0)
                    - if @globus_downloadable
                      .dataset-files-controls-right
                        = link_to "Open in Globus", dataset_open_in_globus_path(@dataset), target: "_blank", rel: "noopener noreferrer", class: "idb-button-primary", aria: {label: "Open files in Globus transfer service"}
                        %a{href: guides_path(anchor: "upload_globus"), target: "_blank", rel: "noopener noreferrer", class: "dataset-help-link", aria: {label: "What is Globus?"}}
                          %i.far.fa-question-circle
                          %span what's this?

              #download-link-modal{role: "dialog", aria: {labelledby: "download-link-modal-title", hidden: "true"}}
                .modal-content
                  %h2#download-link-modal-title Download Link Ready
                  .download-link-info
                    %p Your download link is ready:
                    %p#download-link-result
                    %p#download-file-size
                  %button.idb-button-secondary{type: "button", data: {action: "click->custom-downloader#closeModal"}, aria: {label: "Close download link modal"}} Close

            .dataset-files-list
              - if datafile_count.positive?
                .dataset-files-header
                  .dataset-file-col-checkbox
                    - if show_bulk_file_actions
                      %span.sr-only Select files
                  .dataset-file-col-name
                    %span File Name
                  .dataset-file-col-size
                    %span File Size
                  - if can?(:view_files, @dataset)
                    .dataset-file-col-preview
                      %span Preview
                    .dataset-file-col-download
                      %span Download

                - datafiles.each do |datafile|
                  - file_size = datafile.binary.attached? ? datafile.binary.byte_size : datafile.binary_size
                  .dataset-file-item
                    .dataset-file-col-checkbox
                      - if show_bulk_file_actions
                        %input{type: "checkbox", name: "selected_files[]", value: datafile.web_id, data: {action: "custom-downloader#updateTotal"}, class: "dataset-file-checkbox", aria: {label: "Select #{datafile.binary_name.presence || datafile.web_id}"}}
                    .dataset-file-col-name
                      - if show_bulk_file_actions
                        %span= datafile.binary_name.presence || datafile.web_id
                      - else
                        %span= datafile.binary_name.presence || datafile.web_id
                      - if datafile.description.present?
                        %p.dataset-file-description= datafile.description
                    .dataset-file-col-size
                      %span= file_size.present? ? number_to_human_size(file_size) : "-"
                    .dataset-file-col-preview
                      - if can?(:view_files, @dataset)
                        - preview_label = datafile.preview_button_label
                        - if preview_label.present?
                          = link_to preview_label, view_dataset_datafile_path(@dataset, datafile), target: "_blank", rel: "noopener noreferrer", class: "idb-button-secondary idb-button-sm", aria: {label: "#{preview_label} #{datafile.binary_name.presence || datafile.web_id}"}
                    .dataset-file-col-download
                      - if can?(:view_files, @dataset)
                        = link_to "Download", download_dataset_datafile_path(@dataset, datafile), class: "idb-button-primary idb-button-sm", aria: {label: "Download #{datafile.binary_name.presence || datafile.web_id}"}
              - else
                %p No files available.


    %section.idb-section-card{aria: { label: "Change log" }}
      %details.idb-section-disclosure
        %summary
          %h2.idb-section-title Change Log
        .idb-section-body
          - if @version_request_history.present?
            %ul.dataset-show-list
              - @version_request_history.each do |request|
                %li
                  %span.dataset-show-list-primary= "#{request.status.titleize} request from #{request.requester_name}"
                  = semantic_status_badge(status: request.status, sr_label: "Version request status #{request.status}")
                  %span.dataset-show-list-secondary= "Submitted #{request.requested_at.utc.iso8601}"
                  - if request.comment.present?
                    %span.dataset-show-list-tertiary= request.comment
                  - if request.reviewed_at.present?
                    %span.dataset-show-list-tertiary= "Reviewed #{request.reviewed_at.utc.iso8601}"
                  - if request.review_note.present?
                    %span.dataset-show-list-tertiary= "Review note: #{request.review_note}"
                  - if request.approved_dataset.present?
                    %span.dataset-show-list-tertiary= link_to("Draft created: #{request.approved_dataset.key}", edit_dataset_path(request.approved_dataset))
          - else
            .dataset-show-table-wrap
              %p
                No change log entries available.

  - if logged_in? && (can?(:review_versions, @dataset) || can?(:manage, @dataset))
    %section.idb-section-card{aria: { label: "Curator controls" }}
      %details.idb-section-disclosure{open: true}
        %summary
          %h2.idb-section-title Curator Controls
        .idb-section-body
          - if can?(:manage, @dataset)
            %p
              = link_to "Suppression Controls", suppression_controls_dataset_path(@dataset), class: "idb-button-danger"
          %p
            = link_to "Version Controls", version_controls_dataset_path(@dataset), class: "idb-button-primary"
          %p
            = link_to "Curator Notes", dataset_notes_path(@dataset), class: "idb-button-secondary"

  - if logged_in? && can?(:manage, Dataset)
    %section.idb-section-card{aria: { label: "External delivery" }}
      %details.idb-section-disclosure{open: true}
        %summary
          %h2.idb-section-title External Delivery
        .idb-section-body
          %p
            = link_to "View Delivery Audit", admin_external_delivery_attempts_path(dataset_key: @dataset.key), class: "idb-button-primary"

          - if @ingest_health_summary.present?
            %h3 Ingest Response Health
            %p
              %strong Status:
              = semantic_status_badge(status: @ingest_health_summary[:state], label: @ingest_health_summary[:state].to_s.titleize, sr_label: "Ingest health status #{@ingest_health_summary[:state]}")
              %span.sr-only= "Status: #{@ingest_health_summary[:state].to_s.titleize}"
            %p= @ingest_health_summary[:freshness_message]
            %p= "Orphaned responses in last #{@ingest_health_summary[:orphan_lookback_minutes]} minute(s): #{@ingest_health_summary[:orphan_count]}"
            - if @ingest_health_summary[:alerts].any?
              %ul.dataset-show-list
                - @ingest_health_summary[:alerts].each do |alert|
                  %li
                    %span.dataset-show-list-tertiary= alert

          - if @latest_delivery_attempts.present?
            %ul.dataset-show-list
              - @latest_delivery_attempts.each do |integration, attempt|
                %li
                  %span.dataset-show-list-primary
                    = "#{integration}: "
                    = semantic_status_badge(status: attempt.status, sr_label: "#{integration} status #{attempt.status}")
                    %span.sr-only= "#{integration}: #{attempt.status}"
                  %span.dataset-show-list-secondary= "Attempt #{attempt.attempt} at #{attempt.created_at.utc.iso8601}"
                  - if attempt.error_message.present?
                    %span.dataset-show-list-tertiary= attempt.error_message
          - else
            %p
              No external delivery attempts recorded yet.

          - total_failed = @failed_delivery_counts.values.sum
          - if total_failed.positive?
            %p
              Failed attempts:
              = semantic_count_badge(count: total_failed, label: nil, tone: "danger", sr_label: "Total failed delivery attempts")
            %p
              = button_to "Replay All Failed Deliveries", replay_failed_deliveries_dataset_path(@dataset, integration: "all"), method: :post, class: "idb-button-primary"
              = button_to "Force Replay All Failed Deliveries", replay_failed_deliveries_dataset_path(@dataset, integration: "all", force_replay: true), method: :post, class: "idb-button-secondary", form: { data: { turbo_confirm: "Force replay acknowledged ingest failures for all integrations?" } }
            - @failed_delivery_counts.each do |integration, count|
              %p
                = "#{integration} failures:"
                = semantic_count_badge(count: count, label: nil, tone: "danger", sr_label: "#{integration} failed attempts")
                = button_to "Replay #{integration} Failures", replay_failed_deliveries_dataset_path(@dataset, integration: integration), method: :post, class: "idb-button-primary"
                - if integration.to_s == "ingest"
                  = button_to "Force Replay #{integration} Failures", replay_failed_deliveries_dataset_path(@dataset, integration: integration, force_replay: true), method: :post, class: "idb-button-secondary", form: { data: { turbo_confirm: "Force replay acknowledged ingest failures?" } }
