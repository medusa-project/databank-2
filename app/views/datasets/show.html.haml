- content_for :title, @dataset.title

- doi_url = dataset_persistent_url(@dataset)
- citation_text = dataset_plain_text_citation(@dataset)
- primary_contact_name = dataset_primary_contact_name(@dataset)
- version_related_materials = @dataset.version_related_materials
- nonversion_related_materials = @dataset.nonversion_related_materials
- previous_version = @dataset.previous_version_dataset
- next_version = @dataset.version_successor
- previous_version_material = @dataset.previous_version_material
- next_version_material = version_related_materials.find { |material| material.relation_type == RelatedMaterial::VERSION_NEW_RELATION }
- previous_version_visible = previous_version if previous_version.present? && can?(:read, previous_version)
- next_version_visible = next_version if next_version.present? && can?(:read, next_version)

%ilw-content.dataset-show-page
  .dataset-show-summary
    - if @version_group.latest_published_version.present? && @version_group.latest_published_version != @dataset
      .dataset-show-status
        %p
          %strong A newer version of this dataset is available.
          = " "
          = link_to "View the latest version.", dataset_path(@version_group.latest_published_version)

    .dataset-show-titlebar
      %p.dataset-show-key= @dataset.key

      - if logged_in? && can?(:update, @dataset)
        .dataset-show-actions
          = link_to "Edit Dataset", edit_dataset_path(@dataset), class: "ilw-button"
          - if @dataset.version_eligible?
            = link_to "Request New Version", pre_version_dataset_path(@dataset), class: "ilw-button"
            - if can?(:manage, Dataset)
              = button_to "Create New Version", version_dataset_path(@dataset), method: :post, class: "ilw-button"

    - if @dataset.description.present?
      .dataset-show-abstract
        %h2.dataset-show-section-title Dataset Description
        = simple_format(@dataset.description)

    - if citation_text.present? || doi_url.present?
      .dataset-show-citation
        - if citation_text.present?
          .dataset-show-citation-copy
            %p.dataset-show-eyebrow Cite this dataset:
            %p.dataset-show-citation-text= citation_text

        - if doi_url.present?
          .dataset-show-persistent-link
            %label.dataset-show-eyebrow{for: "persistent-url"} Use this persistent URL to link to this dataset:
            .dataset-show-persistent-controls
              %input#persistent-url.datasets-search-input{type: "text", value: doi_url, readonly: true}
              %button.ilw-button.dataset-show-copy-button{type: "button", onclick: "navigator.clipboard.writeText(document.getElementById('persistent-url').value)"}
                Copy

    - if logged_in? && can?(:update, @dataset)
      - missing = @dataset.missing_publish_fields
      .dataset-show-status
        - if missing.any?
          %p
            %strong Publish requirements missing:
            = " #{missing.join(', ')}"
        - else
          %p
            %strong This dataset is ready to publish.

        - unless @dataset.published?
          = button_to "Publish", publish_dataset_path(@dataset), method: :post, class: "ilw-button"

  .dataset-show-grid
    %section.dataset-show-panel{aria: { label: "Dataset metadata" }}
      %h2.dataset-show-section-title Metadata
      %dl.dataset-show-metadata
        - if doi_url
          %dt DOI
          %dd= link_to @dataset.identifier, doi_url

        - if doi_url
          %dt Persistent URL
          %dd= link_to doi_url, doi_url

        - if @dataset.subject.present?
          %dt Subject
          %dd= link_to @dataset.subject, datasets_path(subjects: [@dataset.subject])

        - if @dataset.keywords.present?
          %dt Keywords
          %dd= @dataset.keywords

        - if @dataset.license.present?
          %dt License
          %dd= @dataset.license

        - if @dataset.publisher.present?
          %dt Publisher
          %dd= @dataset.publisher

        - if primary_contact_name.present?
          %dt Corresponding Creator
          %dd= primary_contact_name

        - if can?(:manage, @dataset)
          %dt Depositor
          %dd= @dataset.depositor_name

          %dt Depositor Email
          %dd= @dataset.depositor_email

    - if previous_version_visible.present? || next_version_visible.present? || previous_version_material.present? || next_version_material.present?
      %section.dataset-show-panel{aria: { label: "Version lineage" }}
        %h2.dataset-show-section-title Version Lineage
        %dl.dataset-show-metadata
          %dt Current Version
          %dd= "#{@dataset.title} (#{@dataset.key})"

          - if previous_version_visible.present?
            %dt Previous Version
            %dd= link_to "#{previous_version_visible.title} (#{previous_version_visible.key})", dataset_path(previous_version_visible)
          - elsif previous_version_material&.uri.present?
            %dt Previous Version
            %dd= link_to(previous_version_material.title, previous_version_material.uri)

          - if next_version_visible.present?
            %dt Next Version
            %dd= link_to "#{next_version_visible.title} (#{next_version_visible.key})", dataset_path(next_version_visible)
          - elsif next_version.nil? && next_version_material&.uri.present?
            %dt Next Version
            %dd= link_to(next_version_material.title, next_version_material.uri)

    - visible_version_entries = @version_group.entries.select { |entry| entry[:dataset].published? || can?(:manage, @dataset) }
    - if visible_version_entries.length > 1
      %section.dataset-show-panel{aria: { label: "Versions in Illinois Data Bank" }}
        %h2.dataset-show-section-title Versions in Illinois Data Bank
        .dataset-show-table-wrap
          %table.dataset-show-table
            %thead
              %tr
                %th Dataset
                %th DOI
                %th State
            %tbody
              - visible_version_entries.each do |entry|
                %tr{ class: (entry[:selected] ? "dataset-show-version-selected" : nil) }
                  %td= link_to "#{entry[:title]} (#{entry[:key]})", dataset_path(entry[:dataset])
                  %td
                    - if entry[:doi].present?
                      = link_to entry[:doi], "https://doi.org/#{entry[:doi]}"
                    - else
                      not yet set
                  %td= entry[:publication_state].to_s

    - if @dataset.creators.any?
      %section.dataset-show-panel{aria: { label: "Creators" }}
        %h2.dataset-show-section-title Creators
        %ul.dataset-show-list
          - @dataset.creators.each do |creator|
            %li
              %span.dataset-show-list-primary= creator.name
              - if creator.contact?
                %span.dataset-show-badge Primary contact
              - if (can?(:update, @dataset) || can?(:manage, @dataset)) && creator.email.present?
                %span.dataset-show-list-secondary= creator.email

    - if @dataset.contributors.any?
      %section.dataset-show-panel{aria: { label: "Contributors" }}
        %h2.dataset-show-section-title Contributors
        %ul.dataset-show-list
          - @dataset.contributors.each do |contributor|
            %li
              %span.dataset-show-list-primary= contributor.name
              - if contributor.role.present?
                %span.dataset-show-list-secondary= contributor.role
              - if (can?(:update, @dataset) || can?(:manage, @dataset)) && contributor.email.present?
                %span.dataset-show-list-tertiary= contributor.email

    - if @dataset.funders.any?
      %section.dataset-show-panel{aria: { label: "Funders" }}
        %h2.dataset-show-section-title Funders
        %ul.dataset-show-list
          - @dataset.funders.each do |funder|
            %li
              %span.dataset-show-list-primary= funder.name
              - if funder.identifier.present?
                %span.dataset-show-list-secondary= funder.identifier
              - if funder.award_number.present?
                %span.dataset-show-list-tertiary= "Award: #{funder.award_number}"

    - if nonversion_related_materials.any?
      %section.dataset-show-panel{aria: { label: "Related materials" }}
        %h2.dataset-show-section-title Related Materials
        %ul.dataset-show-list
          - nonversion_related_materials.each do |material|
            %li
              - if material.uri.present?
                %span.dataset-show-list-primary= link_to material.title, material.uri
              - else
                %span.dataset-show-list-primary= material.title
              - if material.relation_type.present?
                %span.dataset-show-list-secondary= material.relation_type

    - if @dataset.datafiles.any?
      %section.dataset-show-panel{aria: { label: "Files" }}
        %h2.dataset-show-section-title Files
        %ul.dataset-show-file-list
          - @dataset.datafiles.each do |datafile|
            - file_size = datafile.binary.attached? ? datafile.binary.byte_size : datafile.binary_size
            %li
              .dataset-show-file-row
                .dataset-show-file-main
                  %span.dataset-show-list-primary= datafile.binary_name.presence || datafile.web_id
                  - if datafile.description.present?
                    %span.dataset-show-list-tertiary= datafile.description
                .dataset-show-file-meta
                  - if file_size.present?
                    %span.dataset-show-list-secondary= number_to_human_size(file_size)
                  - if can?(:read, @dataset)
                    %span.dataset-show-download= link_to "Download", download_dataset_datafile_path(@dataset, datafile), class: "ilw-button dataset-show-download-button"

    - if @version_request_history.present?
      %section.dataset-show-panel{aria: { label: "Version request history" }}
        %h2.dataset-show-section-title Version Request History
        %ul.dataset-show-list
          - @version_request_history.each do |request|
            %li
              %span.dataset-show-list-primary= "#{request.status.titleize} request from #{request.requester_name}"
              %span.dataset-show-list-secondary= "Submitted #{request.requested_at.utc.iso8601}"
              - if request.comment.present?
                %span.dataset-show-list-tertiary= request.comment
              - if request.reviewed_at.present?
                %span.dataset-show-list-tertiary= "Reviewed #{request.reviewed_at.utc.iso8601}"
              - if request.review_note.present?
                %span.dataset-show-list-tertiary= "Review note: #{request.review_note}"
              - if request.approved_dataset.present?
                %span.dataset-show-list-tertiary= link_to("Draft created: #{request.approved_dataset.key}", edit_dataset_path(request.approved_dataset))

  - if logged_in? && can?(:manage, Dataset)
    %section.dataset-show-panel{aria: { label: "Curator controls" }}
      %h2.dataset-show-section-title Curator Controls
      %p
        = link_to "Version Controls", version_controls_dataset_path(@dataset), class: "ilw-button"

    %section.dataset-show-panel{aria: { label: "External delivery" }}
      %h2.dataset-show-section-title External Delivery

      %p
        = link_to "View Delivery Audit", admin_external_delivery_attempts_path(dataset_key: @dataset.key), class: "ilw-button"

      - if @latest_delivery_attempts.present?
        %ul.dataset-show-list
          - @latest_delivery_attempts.each do |integration, attempt|
            %li
              %span.dataset-show-list-primary= "#{integration}: #{attempt.status}"
              %span.dataset-show-list-secondary= "Attempt #{attempt.attempt} at #{attempt.created_at.utc.iso8601}"
              - if attempt.error_message.present?
                %span.dataset-show-list-tertiary= attempt.error_message
      - else
        %p
          No external delivery attempts recorded yet.

      - total_failed = @failed_delivery_counts.values.sum
      - if total_failed.positive?
        %p
          Failed attempts:
          = total_failed
        %p
          = button_to "Replay All Failed Deliveries", replay_failed_deliveries_dataset_path(@dataset, integration: "all"), method: :post, class: "ilw-button"
        - @failed_delivery_counts.each do |integration, count|
          %p
            = "#{integration} failures: #{count}"
            = button_to "Replay #{integration} Failures", replay_failed_deliveries_dataset_path(@dataset, integration: integration), method: :post, class: "ilw-button"
