- return unless can?(:update, dataset)

- top_strip = placement.to_s == "top"
%section{class: top_strip ? "idb-workflow-strip idb-workflow-strip-top" : "idb-workflow-strip idb-workflow-strip-bottom", aria: { label: "Edit dataset workflow actions" }}
  - if top_strip
    .idb-workflow-note
      - if dataset.draft?
        Edit the dataset description and file set as needed, then save to review before publishing.
      - else
        You can edit the description for the dataset, but you would need to contact the Research Data Service if you need to change, update, or add files for any reason.

  .idb-workflow-actions-right
    - if dataset.draft?
      %button.idb-button-primary{type: "submit", form: form_id}
        Save & Continue

      %button.idb-button-secondary{type: "submit", form: form_id, name: "save_and_exit", value: "true"}
        Save & Exit

      = link_to dataset_path(dataset), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "idb-button-danger" do
        Delete
    - else
      %button.idb-button-primary{type: "submit", form: form_id}
        Confirm

      = link_to datasets_path, class: "idb-button-danger" do
        Cancel