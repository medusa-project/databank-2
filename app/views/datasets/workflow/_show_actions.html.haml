- return unless logged_in? && can?(:update, dataset)

%section.idb-workflow-strip{aria: { label: "Dataset workflow actions" }}
  .idb-workflow-actions-right
    = link_to edit_dataset_path(dataset), class: "idb-button-success" do
      Edit Dataset

    - if dataset.version_eligible?
      = link_to "Request New Version", pre_version_dataset_path(dataset), class: "idb-button-primary"
      - if can?(:review_versions, dataset)
        = button_to "Create New Version", version_dataset_path(dataset), method: :post, class: "idb-button-primary"

    = link_to "Exit this saved dataset", datasets_path, class: "idb-button-secondary"

    - if dataset.draft?
      = link_to dataset_path(dataset), method: :delete, data: { turbo_confirm: "Are you sure? This removes all files and metadata." }, class: "idb-button-danger" do
        Delete