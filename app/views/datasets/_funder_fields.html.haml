= form_with model: [dataset, funder], local: true, html: { data: { controller: "funder-catalog", funder_catalog_identifiers_value: FunderCatalog.identifier_map.to_json } } do |f|
  %p
    = f.label :name
    %br/
    = f.text_field :name, required: true, list: "known-funders", data: { action: "input->funder-catalog#syncIdentifier change->funder-catalog#syncIdentifier", funder_catalog_target: "name" }
  %p
    = f.label :award_number
    %br/
    = f.text_field :award_number
  %p
    = f.label :identifier
    %br/
    = f.text_field :identifier, data: { funder_catalog_target: "identifier" }
  %p
    = f.label :position
    %br/
    = f.number_field :position, min: 1
  %p
    = f.submit submit_label, class: "ilw-button"
