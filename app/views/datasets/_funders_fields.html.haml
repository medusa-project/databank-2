%section#dataset-funders.idb-section-card
  %details.idb-section-disclosure{open: dataset.funders.any? ? true : nil}
    %summary
      %h2.idb-section-title Funders
    .idb-section-body
      .idb-nested-rows{id: "funder-rows"}
        - dataset.funders.each_with_index do |funder, index|
          = f.fields_for :funders, funder do |ff|
            .idb-nested-row
              = ff.hidden_field :id if ff.object.persisted?
              = ff.hidden_field :_destroy, value: false, data: { destroyField: true }
              = ff.hidden_field :row_position, value: (ff.object.row_position || ff.object.position || (index + 1))
              .idb-nested-grid
                .idb-grid-col-3
                  = ff.label :code, "Funder Code"
                  = ff.text_field :code, list: "known-funders"
                .idb-grid-col-4
                  = ff.label :name, "Funder Name"
                  = ff.text_field :name
                .idb-grid-col-4
                  = ff.label :grant, "Grant Number"
                  = ff.text_field :grant
                .idb-grid-col-1.idb-row-actions-inline
                  %button.idb-button-danger{type: "button", aria: { label: "Remove funder row" }, data: { action: "deposit-form#removeRow" }} Remove
                  %button.idb-button-secondary{type: "button", aria: { label: "Move funder row up" }, data: { action: "deposit-form#moveRowUp" }} Up
                  %button.idb-button-secondary{type: "button", aria: { label: "Move funder row down" }, data: { action: "deposit-form#moveRowDown" }} Down
              = ff.hidden_field :identifier
              = ff.hidden_field :identifier_scheme

      %p
        %button.idb-button-secondary{type: "button", data: { action: "deposit-form#addFunderRow" }} Add Funder

      %datalist#known-funders
        - FunderCatalog.known_entries.each do |entry|
          %option{value: entry.code}= entry.name