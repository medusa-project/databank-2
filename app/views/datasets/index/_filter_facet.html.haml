- rows = @facet_options.fetch(facet[:key], [])
%fieldset.search-facet
  %legend.panel-title
    %h3.filter-heading= facet[:title]
  - rows.each do |row|
    - value = dataset_facet_value(facet_key: facet[:key], row: row)
    - checked = dataset_facet_checked?(facet_key: facet[:key], value: value)
    - facet_id = dataset_facet_id(facet_key: facet[:key], value: value)
    .facet-row
      = check_box_tag facet[:param_name], value, checked, id: facet_id, class: "facet-checkbox"
      = label_tag facet_id, "#{dataset_facet_label(facet_key: facet[:key], row: row)} (#{row[:count]})", class: "facet-label"
