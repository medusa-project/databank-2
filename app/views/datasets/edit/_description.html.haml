%section#dataset-description.idb-section-card
  %details.idb-section-disclosure{open: true}
    %summary
      %h2.idb-section-title Description
    .idb-section-body
      %p
        %label.idb-citation-preview-label{for: "citation-preview"} Citation Preview:
        %span#citation-preview.idb-citation-preview-value
          = dataset.creators.map(&:display_name).reject(&:blank?).join("; ").presence || "[Creator List]"
          = " "
          = "(#{Time.current.year}):"
          = " "
          = dataset.title.presence || "[The Title]."
          University of Illinois Urbana-Champaign.
      .idb-metadata-grid
        .idb-grid-col-9
          = f.label :title do
            Dataset Title
          = f.text_field :title, required: true

        .idb-grid-col-3
          .idb-label-with-help
            = f.label :license do
              License
            .idb-inline-help-row
              = contextual_help_link prompt: "What's a license?", url: guides_path(anchor: "license")
          = f.select :license, options_for_select([["CC0", "CC0"], ["CC BY 4.0", "CC-BY-4.0"], ["Other", "other"]], dataset.license), { include_blank: "Select..." }, { required: true }

      = render partial: "datasets/edit/creators", locals: { f: f, dataset: dataset }
      .idb-metadata-grid
        .idb-grid-col-12
          = f.label :description, "Dataset Description"
          = f.text_area :description, rows: 3

        .idb-grid-col-8
          = f.label :keywords, "Keywords [Semicolon separated list of keywords or phrases, e.g.: institutional repositories; file formats]"
          = f.text_field :keywords

        .idb-grid-col-2
          .idb-label-with-help
            = f.label :embargo do
              Publication Delay (embargo)
            .idb-inline-help-row
              = contextual_help_link prompt: "what's an embargo?", url: guides_path(anchor: "embargo")
          = f.select :embargo, options_for_select([["No Publication Delay", "none"], ["File Only Publication Delay", "file"], ["Metadata and File Publication Delay", "metadata"]], dataset.embargo.presence || "none")

        .idb-grid-col-2
          = f.label :release_date, "Release Date"
          = f.date_field :release_date
