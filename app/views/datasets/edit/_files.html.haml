%section#dataset-files.idb-section-card
  %details.idb-section-disclosure{open: true}
    %summary
      %h2.idb-section-title Files
    .idb-section-body
      - can_edit = can?(:manage, dataset) || can?(:update, dataset)

      - if can?(:manage, dataset)
        .idb-file-metadata-actions
          = link_to "Advanced File Management", dataset_datafiles_path(dataset), class: "idb-button-primary"
        .idb-file-metadata-actions
          - if dataset.globus_ingest_configured?
            = link_to "Open Globus Ingest Folder", dataset.globus_ingest_dir, target: "_blank", rel: "noopener noreferrer", class: "idb-button-primary", aria: {label: "Open Globus ingest folder (opens in a new tab)"}
          %button.idb-button-primary{type: "submit", form: "globus-import-form"} Import from Globus
        %p After a Globus transfer finishes, import the files into this dataset. Existing filenames are skipped; repeat after each transfer to import new files.

      - if dataset.draft? && dataset.previous_version_dataset.present? && can?(:update, dataset)
        .idb-file-metadata-actions
          %button.idb-button-primary{type: "submit", form: "copy-version-files-form"} Copy Files from Previous Version

      - if dataset.datafiles.count <= 500
        - if dataset.datafiles.any?
          .idb-file-metadata-container{data: { controller: "bulk-file-actions" }}
            - if can_edit && dataset.datafiles.count > 1
              .idb-file-bulk-header
                .idb-file-bulk-actions
                  %button.idb-button-danger{type: "button", disabled: true, data: { action: "click->bulk-file-actions#requestBulkDelete", bulk_file_actions_target: "deleteButton" }}
                    Delete Selected
                    %span{data: { bulk_file_actions_target: "count" }} (0)
                    %i.fa-solid.fa-trash-can

                .idb-select-all-bar
                  %label.idb-select-all-label
                    %input{type: "checkbox", data: { action: "change->bulk-file-actions#toggleSelectAll", bulk_file_actions_target: "selectAll" }, aria: { label: "Select all files" }}
                    Select all
                    %span.idb-file-count-total= "( #{dataset.datafiles.count} )"

            %table.table.table-striped.idb-file-table#datafiles
              %tbody
                - dataset.datafiles.each do |datafile|
                  %tr
                    %td.idb-file-name-cell
                      - if can_edit && dataset.datafiles.count > 1
                        %label.idb-file-checkbox-label
                          %input{type: "checkbox", name: "selected_files[]", value: datafile.web_id, form: "bulk-file-delete-form", data: { action: "change->bulk-file-actions#updateState", bulk_file_actions_target: "fileCheckbox" }, aria: { label: "Select #{datafile.binary_name.presence || datafile.web_id}" }}
                          = datafile.binary_name.presence || datafile.web_id
                      - else
                        = datafile.binary_name.presence || datafile.web_id
                    %td.idb-file-size-cell
                      = number_to_human_size(datafile.binary_size || 0)
                    %td.idb-file-actions-cell
                      - if can_edit
                        = semantic_action_button action: :delete, type: "submit", form: "datafile-delete-#{datafile.id}", aria: { label: "Delete #{datafile.binary_name.presence || datafile.web_id}" }

        - if can_edit
          .idb-file-upload-section{data: { controller: "file-upload" }}
            .idb-file-upload-container
              .idb-file-upload-area{id: "file-select-area", data: { file_upload_target: "dropZone", action: "dragover->file-upload#handleDragOver dragout->file-upload#handleDragOut drop->file-upload#handleDrop" }}
                %i.fa.fa-cloud-upload-alt.fa-2x
                %p Drop files here or
                %button.idb-button-upload{type: "button", data: { action: "file-upload#selectFiles" }}
                  %span.fa.fa-laptop
                  Select files from your computer
              %input{type: "file", multiple: true, style: "display: none;", aria: { label: "Select files from your computer" }, data: { file_upload_target: "fileInput", action: "change->file-upload#handleFileSelect" }}

              .idb-progress-container{data: { file_upload_target: "progressContainer" }, hidden: true}
                .idb-progress-header
                  .idb-progress-info
                    %span.idb-progress-status{data: { file_upload_target: "statusText" }, aria: { live: "polite" }} Preparing upload...
                    %span.idb-progress-percentage{data: { file_upload_target: "percentageText" }} 0%
                  %button.idb-button-cancel-upload{type: "button", data: { file_upload_target: "cancelButton", action: "click->file-upload#cancelUpload" }}
                    Cancel upload

                .idb-progress-track{data: { file_upload_target: "progressBar" }, role: "progressbar", aria: { valuemin: "0", valuemax: "100", valuenow: "0", label: "File upload progress" }}
                  .idb-progress-fill{data: { file_upload_target: "progressFill" }, style: "width: 0%;"}

              %ul.idb-file-upload-guidelines
                %li
                  Use our
                  = link_to "File Grouping guide", "/guides#group", class: "idb-link"
                  for folders or more than 12 files.
                %li
                  Drag-and-drop and file selector are reliable for files
                  %strong up to 4 GB.
                %li
                  %strong Limit 100 files per dataset;
                  fewer is better for usability.
                %li For larger files or command line tools, contact the Research Data Service.

      - else
        %p
          Error displaying files, please
          = link_to "contact", "/contact"
          the Research Data Service.
