%section#dataset-related-materials.idb-section-card
  %details.idb-section-disclosure{open: dataset.related_materials.any? ? true : nil}
    %summary
      %h2.idb-section-title Related Materials
    .idb-section-body
      .idb-nested-rows{id: "material-rows"}
        - if dataset.related_materials.any?
          - dataset.related_materials.each_with_index do |material, index|
            = f.fields_for :related_materials, material do |mf|
              .idb-nested-row{data: { deposit_form_target: "materialRow" }}
                = mf.hidden_field :id if mf.object.persisted?
                = mf.hidden_field :_destroy, value: false, data: { destroyField: true }
                = mf.hidden_field :row_position, value: (mf.object.row_position || mf.object.position || (index + 1))
                = mf.hidden_field :datacite_list, data: { dataciteListField: true }
                .idb-nested-grid
                  .idb-grid-col-2
                    = mf.label :selected_type, "Related Resource Type"
                    = mf.select :selected_type, options_for_select(["Article", "Code", "Dataset", "Presentation", "Thesis", "Other"], mf.object.selected_type), { include_blank: "Select..." }, { data: { action: "change->deposit-form#materialTypeChanged" } }
                  .idb-grid-col-2
                    = mf.label :material_type, "Material Type"
                    = mf.text_field :material_type, data: { materialTypeField: true }
                  .idb-grid-col-3
                    = mf.label :link, "Resource URL"
                    = mf.text_field :link
                  .idb-grid-col-4
                    = mf.label :citation
                    = mf.text_area :citation, rows: 2
                  .idb-grid-col-1.idb-row-actions-inline
                    %button.idb-button-danger{type: "button", aria: { label: "Remove related material row" }, data: { action: "deposit-form#removeRow" }} Remove
                    %button.idb-button-secondary{type: "button", aria: { label: "Move related material row up" }, data: { action: "deposit-form#moveRowUp" }} Up
                    %button.idb-button-secondary{type: "button", aria: { label: "Move related material row down" }, data: { action: "deposit-form#moveRowDown" }} Down

                - if can?(:manage, dataset)
                  %fieldset.idb-grid-fieldset.idb-curator-only-section.idb-curator-only-section--compact
                    %legend DataCite Relationships (Curator and admin)
                    .idb-nested-grid
                      .idb-grid-col-5
                        - ["IsSupplementTo", "IsSupplementedBy", "IsCitedBy", "IsPreviousVersionOf", "IsNewVersionOf"].each do |relationship|
                          %label
                            %input{type: "checkbox", value: relationship, checked: mf.object.datacite_list.to_s.split(",").map(&:strip).include?(relationship), data: { action: "change->deposit-form#syncDataciteList", dataciteCheck: true }}
                            = relationship
                      .idb-grid-col-2
                        = mf.label :uri_type
                        = mf.text_field :uri_type
                      .idb-grid-col-3
                        = mf.label :uri
                        = mf.text_field :uri
                      .idb-grid-col-2
                        = mf.label :note
                        = mf.text_field :note
        - else
          = f.fields_for :related_materials, RelatedMaterial.new do |mf|
            .idb-nested-row{data: { deposit_form_target: "materialRow" }}
              = mf.hidden_field :_destroy, value: false, data: { destroyField: true }
              = mf.hidden_field :row_position, value: 1
              = mf.hidden_field :datacite_list, data: { dataciteListField: true }
              .idb-nested-grid
                .idb-grid-col-2
                  = mf.label :selected_type, "Related Resource Type"
                  = mf.select :selected_type, options_for_select(["Article", "Code", "Dataset", "Presentation", "Thesis", "Other"]), { include_blank: "Select..." }, { data: { action: "change->deposit-form#materialTypeChanged" } }
                .idb-grid-col-2
                  = mf.label :material_type, "Material Type"
                  = mf.text_field :material_type, data: { materialTypeField: true }
                .idb-grid-col-3
                  = mf.label :link, "Resource URL"
                  = mf.text_field :link
                .idb-grid-col-4
                  = mf.label :citation
                  = mf.text_area :citation, rows: 2
                .idb-grid-col-1.idb-row-actions-inline
                  %button.idb-button-danger{type: "button", aria: { label: "Remove related material row" }, data: { action: "deposit-form#removeRow" }} Remove
                  %button.idb-button-secondary{type: "button", aria: { label: "Move related material row up" }, data: { action: "deposit-form#moveRowUp" }} Up
                  %button.idb-button-secondary{type: "button", aria: { label: "Move related material row down" }, data: { action: "deposit-form#moveRowDown" }} Down

              - if can?(:manage, dataset)
                %fieldset.idb-grid-fieldset.idb-curator-only-section.idb-curator-only-section--compact
                  %legend DataCite Relationships (Curator and admin)
                  .idb-nested-grid
                    .idb-grid-col-5
                      - ["IsSupplementTo", "IsSupplementedBy", "IsCitedBy", "IsPreviousVersionOf", "IsNewVersionOf"].each do |relationship|
                        %label
                          %input{type: "checkbox", value: relationship, data: { action: "change->deposit-form#syncDataciteList", dataciteCheck: true }}
                          = relationship
                    .idb-grid-col-2
                      = mf.label :uri_type
                      = mf.text_field :uri_type
                    .idb-grid-col-3
                      = mf.label :uri
                      = mf.text_field :uri
                    .idb-grid-col-2
                      = mf.label :note
                      = mf.text_field :note
      %p
        %button.idb-button-secondary{type: "button", data: { action: "deposit-form#addMaterialRow" }} Add Related Material

%template{data: { deposit_form_target: "materialTemplate" }}
  = f.fields_for :related_materials, RelatedMaterial.new, child_index: "NEW_MATERIAL" do |mf|
    .idb-nested-row{data: { deposit_form_target: "materialRow" }}
      = mf.hidden_field :_destroy, value: false, data: { destroyField: true }
      = mf.hidden_field :row_position, value: 999
      = mf.hidden_field :datacite_list, data: { dataciteListField: true }
      .idb-nested-grid
        .idb-grid-col-2
          = mf.label :selected_type, "Related Resource Type"
          = mf.select :selected_type, options_for_select(["Article", "Code", "Dataset", "Presentation", "Thesis", "Other"]), { include_blank: "Select..." }, { data: { action: "change->deposit-form#materialTypeChanged" } }
        .idb-grid-col-2
          = mf.label :material_type, "Material Type"
          = mf.text_field :material_type, data: { materialTypeField: true }
        .idb-grid-col-3
          = mf.label :link, "Resource URL"
          = mf.text_field :link
        .idb-grid-col-4
          = mf.label :citation
          = mf.text_area :citation, rows: 2
        .idb-grid-col-1.idb-row-actions-inline
          %button.idb-button-danger{type: "button", aria: { label: "Remove related material row" }, data: { action: "deposit-form#removeRow" }} Remove
          %button.idb-button-secondary{type: "button", aria: { label: "Move related material row up" }, data: { action: "deposit-form#moveRowUp" }} Up
          %button.idb-button-secondary{type: "button", aria: { label: "Move related material row down" }, data: { action: "deposit-form#moveRowDown" }} Down
      - if can?(:manage, dataset)
        %fieldset.idb-grid-fieldset.idb-curator-only-section.idb-curator-only-section--compact
          %legend DataCite Relationships (Curator and admin)
          .idb-nested-grid
            .idb-grid-col-5
              - ["IsSupplementTo", "IsSupplementedBy", "IsCitedBy", "IsPreviousVersionOf", "IsNewVersionOf"].each do |relationship|
                %label
                  %input{type: "checkbox", value: relationship, data: { action: "change->deposit-form#syncDataciteList", dataciteCheck: true }}
                  = relationship
            .idb-grid-col-2
              = mf.label :uri_type
              = mf.text_field :uri_type
            .idb-grid-col-3
              = mf.label :uri
              = mf.text_field :uri
            .idb-grid-col-2
              = mf.label :note
              = mf.text_field :note