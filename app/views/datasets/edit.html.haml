- content_for :title, @dataset.title.present? ? "Edit Dataset: #{@dataset.title}" : "Edit Dataset"
- content_for :include_orcid_css, true

%ilw-content.dataset-form-page.idb-page-sections
  .idb-sections-layout
    .idb-sections-content
      - orcid_lookup_url = @dataset.persisted? ? orcid_lookup_dataset_creators_path(@dataset) : ""
      - form_id = "dataset-edit-form"
      - form_html = { class: "idb-legacy-compact-form", data: { controller: "deposit-form", orcid_lookup_url: orcid_lookup_url }, id: form_id }

      - if @dataset.errors.any?
        %div.ilw-notice.ilw-notice--error
          %p Please fix the following errors:
          %ul
            - @dataset.errors.full_messages.each do |message|
              %li
                = message

      = form_with model: @dataset, local: true, html: form_html do |f|
        = f.hidden_field :org_creators, data: { deposit_form_target: "orgCreatorsField" }
        - if can?(:manage, @dataset)
          = render "datasets/edit/curation", f: f, dataset: @dataset
        = render "datasets/edit/description", f: f, dataset: @dataset
        = render "datasets/edit/funders", f: f, dataset: @dataset
        = render "datasets/edit/related_materials", f: f, dataset: @dataset
        = render "/datasets/show/versions", dataset: @dataset
        - if @dataset.draft?
          = render "datasets/edit/files", f: f, dataset: @dataset
        - else
          = render "datasets/show/files", dataset: @dataset
        - if @dataset.draft?
          = render "datasets/edit/advanced_upload", f: f, dataset: @dataset
        - if can?(:update, @dataset)
          = render "datasets/edit/actions", dataset: @dataset, form_id: form_id
        = render "datasets/edit/orcid_lookup_modal"

      - if @dataset.draft? && can?(:update, @dataset)
        = form_with url: dataset_path(@dataset), method: :delete, local: true, id: "dataset-delete-form", data: { turbo_confirm: "Are you sure?" } do
          -# The delete control is in the workflow strip, outside this form.

      - if can?(:manage, @dataset)
        = form_with url: import_from_globus_dataset_path(@dataset), method: :post, local: true, id: "globus-import-form" do
          -# The submit button is in the files section, outside this form.
        = form_with model: [@dataset, DatasetAccessGrant.new], local: true, id: "dataset-access-grant-form" do
          -# Controls are associated using the form attribute to avoid nested forms.
        - creator_emails = @dataset.creators.map(&:email).to_set
        - @dataset.dataset_access_grants.each do |grant|
          - unless creator_emails.include?(grant.email)
            = form_with url: dataset_dataset_access_grant_path(@dataset, grant), method: :delete, local: true, id: "dataset-access-grant-remove-#{grant.id}", data: { turbo_confirm: "Remove access for #{grant.email}?" } do
              -# The submit button remains in the curation section.
      - if can?(:manage, @dataset) || can?(:update, @dataset)
        = form_with url: bulk_destroy_dataset_datafiles_path(@dataset), method: :post, local: true, id: "bulk-file-delete-form" do
          -# File checkboxes are associated using the form attribute.
        - if @dataset.datafiles.count <= 500
          - @dataset.datafiles.each do |datafile|
            = form_with url: dataset_datafile_path(@dataset, datafile), method: :delete, local: true, id: "datafile-delete-#{datafile.id}" do
              -# The submit button remains in the files section.
      - if @dataset.draft? && @dataset.previous_version_dataset.present? && can?(:update, @dataset)
        = form_with url: copy_version_files_dataset_path(@dataset), method: :post, local: true, id: "copy-version-files-form" do
          -# The submit button remains in the files section.
