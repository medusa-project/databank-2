- if datafile_count.positive? || dataset.external_files?
  %section.idb-section-card{aria: { label: "Files" }}
    %details.idb-section-disclosure{open: true}
      %summary
        - if dataset.external_files?
          %h2.idb-section-title Files - Subset
        - else
          %h2.idb-section-title Files
      .idb-section-body
        - if dataset.external_files?
          = render "show_external_files", dataset: dataset

        = render "file_restriction_alert", dataset: dataset
        = render "globus_delay_alert", dataset: dataset
        - if show_bulk_file_actions
          .dataset-files-controls
            %form#custom-download-form{data: {controller: "custom-downloader"}, style: "margin: 0"}
              .dataset-files-controls-row
                .dataset-files-controls-left
                  %label.dataset-select-all-label
                    %input#checkAllFiles{type: "checkbox", data: {action: "custom-downloader#toggleSelectAll"}, aria: {label: "Select all files"}}
                    %span Select all
                .dataset-files-controls-center
                  %button.idb-button-primary{type: "button", data: {action: "custom-downloader#requestDownload"}, id: "request-download-button", disabled: true, aria: {label: "Create a custom zip file with selected files from this dataset"}}
                    %span Get Custom Zip and Download Link for Selected
                    %span#custom-download-count (0)
                - if globus_downloadable
                  .dataset-files-controls-right
                    = link_to "Open in Globus", dataset_open_in_globus_path(dataset), target: "_blank", rel: "noopener noreferrer", class: "idb-button-primary", aria: {label: "Open files in Globus transfer service"}
                    %a{href: guides_path(anchor: "upload_globus"), target: "_blank", rel: "noopener noreferrer", class: "dataset-help-link", aria: {label: "What is Globus?"}}
                      %i.far.fa-question-circle
                      %span what's this?

          #download-link-modal{role: "dialog", aria: {labelledby: "download-link-modal-title", hidden: "true"}}
            .modal-content
              %h2#download-link-modal-title Download Link Ready
              .download-link-info
                %p Your download link is ready:
                %p#download-link-result
                %p#download-file-size
              %button.idb-button-secondary{type: "button", data: {action: "click->custom-downloader#closeModal"}, aria: {label: "Close download link modal"}} Close

        .dataset-files-list
          - if datafile_count.positive?
            .dataset-files-header
              .dataset-file-col-checkbox
                - if show_bulk_file_actions
                  %span.sr-only Select files
              .dataset-file-col-name
                %span File Name
              .dataset-file-col-size
                %span File Size
              - if can?(:view_files, dataset)
                .dataset-file-col-preview
                  %span Preview
                .dataset-file-col-download
                  %span Download

            - datafiles.each do |datafile|
              - file_size = datafile.binary.attached? ? datafile.binary.byte_size : datafile.binary_size
              .dataset-file-item
                .dataset-file-col-checkbox
                  - if show_bulk_file_actions
                    %input{type: "checkbox", name: "selected_files[]", value: datafile.web_id, data: {action: "custom-downloader#updateTotal"}, class: "dataset-file-checkbox", aria: {label: "Select #{datafile.binary_name.presence || datafile.web_id}"}}
                .dataset-file-col-name
                  %span= datafile.binary_name.presence || datafile.web_id
                  - if datafile.description.present?
                    %p.dataset-file-description= datafile.description
                .dataset-file-col-size
                  %span= file_size.present? ? number_to_human_size(file_size) : "-"
                .dataset-file-col-preview
                  - if can?(:view_files, dataset)
                    - preview_label = datafile.preview_button_label
                    - if preview_label.present?
                      = semantic_action_button(action: :preview, url: view_dataset_datafile_path(dataset, datafile), label: preview_label, style: :idb, target: "_blank", rel: "noopener noreferrer", aria_label: "#{preview_label} #{datafile.binary_name.presence || datafile.web_id}", class: "idb-button-sm")
                .dataset-file-col-download
                  - if can?(:view_files, dataset)
                    = semantic_action_button(action: :download, url: download_dataset_datafile_path(dataset, datafile), style: :idb, aria_label: "Download #{datafile.binary_name.presence || datafile.web_id}", class: "idb-button-sm")
          - else
            %p No files available.