- visible_version_entries = @version_group.entries.select { |entry| entry[:dataset].published? || can?(:review_versions, @dataset) }
- if visible_version_entries.any?
  %section.idb-section-card{aria: { label: "Versions in Illinois Data Bank" }}
    %details.idb-section-disclosure{open: (visible_version_entries.length > 1)}
      %summary
        %h2.idb-section-title= visible_version_entries.length > 1 ? "Versions in Illinois Data Bank" : "Versions"
      .idb-section-body
        .dataset-show-table-wrap
          %table.dataset-show-table
            %thead
              %tr
                %th.version-cell
                  Version
                %th DOI
                %th Comment
                %th Publication Date
            %tbody
              - visible_version_entries.each do |entry|
                %tr{ class: (entry[:selected] ? "dataset-show-version-selected" : nil) }
                  %td.version-cell
                    = entry[:version].present? ? entry[:version] : entry[:title]
                  %td
                    - if entry[:doi].present?
                      = link_to entry[:doi], "https://doi.org/#{entry[:doi]}"
                    - else
                      = link_to "DOI not yet set", dataset_path(entry[:dataset]) if entry[:dataset].present?
                  %td= entry[:comment]
                  %td= entry[:publication_date]