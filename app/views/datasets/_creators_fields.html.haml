#dataset-creators.idb-core-subsection{data: { deposit_form_target: "creatorDisclosure" }}
  %h3.idb-creators-subheading
    Author List
    %span.idb-inline-help-row
      = contextual_help_link prompt: "what's an author?", url: policies_path(anchor: "creator-definition")
  .idb-section-body
    - if can?(:manage, dataset)
      .idb-curator-only-section
        %p.idb-curator-only-kicker Curator and admin only
        %p
          %button.idb-button-secondary{type: "button", data: { action: "deposit-form#switchCreatorMode", mode: "person" }}
            Use Individual Creators
          = " "
          %button.idb-button-secondary{type: "button", data: { action: "deposit-form#switchCreatorMode", mode: "institution" }}
            Use Organization Creators
          = " "
          - if creator_mode_org
            = contextual_help_link prompt: "citing individual(s) as author(s)?", url: policies_path(anchor: "creator-definition")
          - else
            = contextual_help_link prompt: "citing organization as author?", url: policies_path(anchor: "creator-definition")
        %p
          %strong Curator and admin note:
          Switching creator type deletes creator records of the other type and saves the form.

    - creators_for_mode = creator_mode_org ? dataset.institutional_creators : dataset.individual_creators
    - if creators_for_mode.empty?
      - dataset.creators.build(type_of: default_creator_type, row_position: 1)
      - creators_for_mode = creator_mode_org ? dataset.institutional_creators : dataset.individual_creators

    - if creator_mode_org
      %p One primary long-term contact must be selected from the organizational author list.

      %table.idb-compact-table.idb-compact-table-org
        %thead
          %tr
            %th
              %span.sr-only Reorder
            %th
              Organization Name(s)
              %sup.idb-required-indicator{aria: { hidden: true }} *
              %span.sr-only required
            %th
              Email
              %sup.idb-required-indicator{aria: { hidden: true }} *
              %span.sr-only required
            %th
              Primary Contact
              %sup.idb-required-indicator{aria: { hidden: true }} *
              %span.sr-only required
              .idb-inline-help-row
                = contextual_help_link prompt: "what's a primary contact?", url: pre_deposit_datasets_path(anchor: "predeposit-contact")
            %th.idb-actions-header-cell
              %span.sr-only Actions
        %tbody.idb-nested-rows{id: "creator-rows"}
          - creators_for_mode.each_with_index do |creator, index|
            = f.fields_for :creators, creator do |cf|
              %tr.idb-nested-row{data: { deposit_form_target: "creatorRow" }}
                %td.idb-drag-cell
                  %span{aria: { hidden: true }} ≡
                %td
                  = cf.hidden_field :id if cf.object.persisted?
                  = cf.hidden_field :_destroy, value: false, data: { destroyField: true }
                  = cf.hidden_field :row_position, value: (cf.object.row_position || cf.object.position || (index + 1))
                  = cf.hidden_field :type_of, value: Dataset::CREATOR_TYPE_INSTITUTION, data: { creatorType: true }
                  = cf.hidden_field :contact, value: (creator.contact_selected? ? true : false), data: { contactField: true }
                  = cf.hidden_field :is_contact, value: (creator.contact_selected? ? true : false), data: { isContactField: true }
                  = cf.text_field :institution_name, value: (cf.object.institution_name.presence || cf.object.name), placeholder: "[Organization Name]", required: true
                %td
                  = cf.email_field :email, placeholder: "[e.g.: creator@institute.org]", required: true
                %td.idb-contact-cell
                  %input{type: "radio", name: "primary_contact_index", value: index, checked: creator.contact_selected?, required: true, aria: { label: "Primary Contact" }, data: { action: "change->deposit-form#syncPrimaryContact" }}
                %td.idb-row-actions.idb-creator-row-actions
                  = semantic_action_button action: :up, style: :idb, type: "button", icon_only: true, aria_label: "Move author row up", title: "Move author row up", class: "idb-compact-action", data: { action: "deposit-form#moveRowUp" }
                  = semantic_action_button action: :down, style: :idb, type: "button", icon_only: true, aria_label: "Move author row down", title: "Move author row down", class: "idb-compact-action", data: { action: "deposit-form#moveRowDown" }
                  = semantic_action_button action: :remove, style: :idb, type: "button", icon_only: true, aria_label: "Remove author row", title: "Remove author row", class: "idb-compact-action", data: { action: "deposit-form#removeRow" }
      .idb-creator-add-row
        = semantic_action_button action: :add, style: :idb, type: "button", aria_label: "Add author row", title: "Add author row", label: "Add author row", data: { action: "deposit-form#addCreatorRow" }
    - else
      %p One primary long-term contact must be selected from the individual author list.

      %table.idb-compact-table.idb-compact-table-individual
        %thead
          %tr
            %th
              %span.sr-only Reorder
            %th
              Family Name(s)
              %sup.idb-required-indicator{aria: { hidden: true }} *
              %span.sr-only required
            %th
              Given Name(s)
              %sup.idb-required-indicator{aria: { hidden: true }} *
              %span.sr-only required
            %th
              %span.idb-orcid-header-label
                ORCID
                %sup &trade;
                = image_tag 'iD_icon.png', alt: "", aria: { hidden: true }
              .idb-inline-help-row
                = contextual_help_link prompt: "what's an ORCID?", url: "https://orcid.org/"
            %th
              %span.sr-only ORCID Lookup
            %th
              Email
              %sup.idb-required-indicator{aria: { hidden: true }} *
              %span.sr-only required
            %th
              Primary Contact
              %sup.idb-required-indicator{aria: { hidden: true }} *
              %span.sr-only required
              .idb-inline-help-row
                = contextual_help_link prompt: "what's a primary contact?", url: pre_deposit_datasets_path(anchor: "predeposit-contact")
            %th.idb-actions-header-cell
              %span.sr-only Actions
        %tbody.idb-nested-rows{id: "creator-rows"}
          - creators_for_mode.each_with_index do |creator, index|
            = f.fields_for :creators, creator do |cf|
              %tr.idb-nested-row{data: { deposit_form_target: "creatorRow" }}
                %td.idb-drag-cell
                  %span{aria: { hidden: true }} ≡
                %td
                  = cf.hidden_field :id if cf.object.persisted?
                  = cf.hidden_field :_destroy, value: false, data: { destroyField: true }
                  = cf.hidden_field :row_position, value: (cf.object.row_position || cf.object.position || (index + 1))
                  = cf.hidden_field :type_of, value: Dataset::CREATOR_TYPE_PERSON, data: { creatorType: true }
                  = cf.hidden_field :contact, value: (creator.contact_selected? ? true : false), data: { contactField: true }
                  = cf.hidden_field :is_contact, value: (creator.contact_selected? ? true : false), data: { isContactField: true }
                  = cf.text_field :family_name, placeholder: "[e.g.: Smith]", required: true
                %td
                  = cf.text_field :given_name, placeholder: "[e.g.: Jean W.]", required: true
                %td
                  = cf.text_field :identifier, placeholder: "0000-0000-0000-0000", data: { orcidField: true }
                  = cf.hidden_field :identifier_scheme, value: "ORCID"
                %td
                  %button.idb-button-secondary{type: "button", disabled: !orcid_lookup_enabled, data: { action: "deposit-form#openOrcidLookup" }} Look Up ORCID
                %td
                  = cf.email_field :email, placeholder: "[e.g.: netid@illinois.edu]", required: true
                %td.idb-contact-cell
                  %input{type: "radio", name: "primary_contact_index", value: index, checked: creator.contact_selected?, required: true, aria: { label: "Primary Contact" }, data: { action: "change->deposit-form#syncPrimaryContact" }}
                %td.idb-row-actions.idb-creator-row-actions
                  = semantic_action_button action: :up, style: :idb, type: "button", icon_only: true, aria_label: "Move author row up", title: "Move author row up", class: "idb-compact-action", data: { action: "deposit-form#moveRowUp" }
                  = semantic_action_button action: :down, style: :idb, type: "button", icon_only: true, aria_label: "Move author row down", title: "Move author row down", class: "idb-compact-action", data: { action: "deposit-form#moveRowDown" }
                  = semantic_action_button action: :remove, style: :idb, type: "button", icon_only: true, aria_label: "Remove author row", title: "Remove author row", class: "idb-compact-action", data: { action: "deposit-form#removeRow" }
      .idb-creator-add-row
        = semantic_action_button action: :add, style: :idb, type: "button", aria_label: "Add author row", title: "Add author row", label: "Add author row", data: { action: "deposit-form#addCreatorRow" }