- content_for :title, "Datasets"

%ilw-page-title
  %h1{slot: "title"} Datasets

%ilw-content
  - if logged_in?
    %p
      %a.ilw-button{href: new_dataset_path} Deposit a New Dataset

  = form_with url: datasets_path, method: :get, local: true do |f|
    %p
      = f.label :q, "Search"
      %br/
      = f.search_field :q, value: @query, placeholder: "Title, description, keywords"
    %p
      = f.label :subject, "Subject"
      %br/
      = f.text_field :subject, value: @subject, placeholder: "Exact subject"
    %p
      = f.submit "Apply Filters", class: "ilw-button"
      = link_to "Clear", datasets_path, class: "ilw-button"

  - if @datasets.any?
    - @datasets.each do |dataset|
      %ilw-card
        %h2{slot: "title"}= link_to dataset.title, dataset_path(dataset)
        %p= dataset.key
        - if dataset.description.present?
          %p= truncate(dataset.description, length: 200)
        - if dataset.published?
          %span{slot: "metadata"} Published
  - else
    %p No datasets found.
