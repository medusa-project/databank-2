- content_for :title, "Dataset Search"

%ilw-content.datasets-search-page
  - if @report_mode
    = render partial: "citation_report"
  - else
    = form_with url: datasets_path, method: :get, local: true, html: { id: "datasets-search-form", class: "datasets-search-form", role: "search", aria: { label: "Dataset search and filters" } } do |f|
      .datasets-toolbar
        .datasets-query-controls
          = f.label :q, "Search datasets", class: "sr-only"
          .datasets-query-fieldset
            = f.search_field :q, value: @query, placeholder: "search for datasets", class: "datasets-search-input", aria: { label: "Search datasets" }
            = button_tag type: "submit", class: "legacy-btn legacy-btn-primary legacy-btn-with-icon legacy-btn-icon-only datasets-query-button", aria: { label: "Submit search" } do
              %i.fa-solid.fa-magnifying-glass{aria: { hidden: true }}
            = link_to datasets_path(index_query_params(q: nil, page: 1)), class: "legacy-btn legacy-btn-danger legacy-btn-with-icon legacy-btn-icon-only datasets-query-button datasets-clear-button", aria: { label: "Clear search term" } do
              %i.fa-solid.fa-xmark{aria: { hidden: true }}

        - if @total_count.positive?
          - start_item = @search.offset_value + 1
          - end_item = [@search.offset_value + @datasets.length, @total_count].min
          %p.datasets-results-count{aria: { live: "polite" }}= "Displaying #{start_item} - #{end_item} of #{@total_count} in total"

        - if @total_pages > 1
          %nav.datasets-pagination.datasets-pagination-top{aria: { label: "Results pagination (top)" }}
            - if @page > 1
              = link_to "<", datasets_path(index_query_params(page: @page - 1)), class: "datasets-page-link", aria: { label: "Previous page" }
            - pagination_items.each do |item|
              - if item == :gap
                %span.datasets-page-ellipsis{aria: { hidden: true }} ...
              - elsif item == @page
                %span.datasets-page-current{aria: { current: "page" }}= item
              - else
                = link_to item, datasets_path(index_query_params(page: item)), class: "datasets-page-link", aria: { label: "Page #{item}" }
            - if @page < @total_pages
              = link_to ">", datasets_path(index_query_params(page: @page + 1)), class: "datasets-page-link", aria: { label: "Next page" }

        .datasets-per-page-control
          = f.label :per_page, "Results per page", class: "sr-only"
          .datasets-per-page-inline
            = f.select :per_page, options_for_select(Search::DatasetSearch::PER_PAGE_OPTIONS.map { |value| ["#{value} per page", value] }, @per_page), {}, class: "datasets-select-input", aria: { label: "Results per page" }
            = f.submit "Go", class: "idb-button-primary datasets-go-button", aria: { label: "Apply results per page" }

      .datasets-search-layout
        %section.datasets-filters-panel{aria: { labelledby: "datasets-filters-heading" }}
          .datasets-filter-header
            %h2#datasets-filters-heading.datasets-section-heading Filters
            .datasets-filter-actions
              = link_to "Clear Filters", datasets_path(q: @query, per_page: @per_page), class: "idb-button-secondary datasets-clear-filters"
              - if @total_count.positive?
                = link_to "Generate Report from Search Results", datasets_path(index_query_params(report: "generate")), class: "idb-button-primary datasets-generate-report-button"

          - if @available_facets.include?(:subjects)
            %fieldset.search-facet
              %legend.panel-title
                %h3.filter-heading Subject Area
              - @facet_options.fetch(:subjects, []).each do |row|
                - checked = Array(params[:subjects]).include?(row[:value])
                - subject_id = "subject_#{row[:value].to_s.parameterize}"
                .facet-row
                  = check_box_tag "subjects[]", row[:value], checked, id: subject_id, class: "facet-checkbox"
                  = label_tag subject_id, "#{row[:value]} (#{row[:count]})", class: "facet-label"

          - if @available_facets.include?(:funders)
            %fieldset.search-facet
              %legend.panel-title
                %h3.filter-heading Funder
              - @facet_options.fetch(:funders, []).each do |row|
                - checked = Array(params[:funders]).include?(row[:value])
                - funder_id = "funder_#{row[:value].to_s.parameterize}"
                .facet-row
                  = check_box_tag "funders[]", row[:value], checked, id: funder_id, class: "facet-checkbox"
                  = label_tag funder_id, "#{row.fetch(:label, row[:value])} (#{row[:count]})", class: "facet-label"

          - if @available_facets.include?(:publication_years)
            %fieldset.search-facet
              %legend.panel-title
                %h3.filter-heading Publication Year
              - @facet_options.fetch(:publication_years, []).each do |row|
                - value = row[:value].to_s
                - checked = Array(params[:publication_years]).include?(value)
                - year_id = "publication_year_#{value}"
                .facet-row
                  = check_box_tag "publication_years[]", value, checked, id: year_id, class: "facet-checkbox"
                  = label_tag year_id, "#{value} (#{row[:count]})", class: "facet-label"

          - if @available_facets.include?(:licenses)
            %fieldset.search-facet
              %legend.panel-title
                %h3.filter-heading License
              - @facet_options.fetch(:licenses, []).each do |row|
                - checked = Array(params[:licenses]).include?(row[:value])
                - license_id = "license_#{row[:value].to_s.parameterize}"
                .facet-row
                  = check_box_tag "licenses[]", row[:value], checked, id: license_id, class: "facet-checkbox"
                  = label_tag license_id, "#{row[:value]} (#{row[:count]})", class: "facet-label"

          - if @available_facets.include?(:publication_states)
            %fieldset.search-facet
              %legend.panel-title
                %h3.filter-heading Publication State
              - @facet_options.fetch(:publication_states, []).each do |row|
                - state_value = row[:value].to_s
                - checked = Array(params[:publication_states]).include?(state_value)
                - state_id = "publication_state_#{state_value.parameterize}"
                .facet-row
                  = check_box_tag "publication_states[]", state_value, checked, id: state_id, class: "facet-checkbox"
                  = label_tag state_id, "#{state_value.humanize} (#{row[:count]})", class: "facet-label"

          - if @available_facets.include?(:depositors)
            %fieldset.search-facet
              %legend.panel-title
                %h3.filter-heading Depositor
              - @facet_options.fetch(:depositors, []).each do |row|
                - checked = Array(params[:depositors]).include?(row[:value])
                - depositor_id = "depositor_#{row[:value].to_s.parameterize}"
                .facet-row
                  = check_box_tag "depositors[]", row[:value], checked, id: depositor_id, class: "facet-checkbox"
                  = label_tag depositor_id, "#{row[:label]} (#{row[:count]})", class: "facet-label"

          - if @available_facets.include?(:external_files)
            %fieldset.search-facet
              %legend.panel-title
                %h3.filter-heading External Files
              - @facet_options.fetch(:external_files, []).each do |row|
                - checked = Array(params[:external_files]).include?(row[:value])
                - external_files_id = "external_files_#{row[:value].to_s.parameterize}"
                .facet-row
                  = check_box_tag "external_files[]", row[:value], checked, id: external_files_id, class: "facet-checkbox"
                  = label_tag external_files_id, "#{row[:label]} (#{row[:count]})", class: "facet-label"

        %section.datasets-results-panel{aria: { labelledby: "datasets-results-heading" }}
          %h2#datasets-results-heading.datasets-section-heading Results

          - if @datasets.any?
            .datasets-results-list
              - @datasets.each do |dataset|
                %article.dataset-result-card
                  - if can?(:manage, dataset)
                    .dataset-result-curator-badges
                      = semantic_badge(kind: :neutral, label: "updated: #{dataset.updated_at.to_date.iso8601}", icon: "calendar-day", icon_style: :solid, sr_label: "Updated #{dataset.updated_at.to_date.iso8601}")
                      = semantic_badge(kind: :neutral, label: "created: #{dataset.created_at.to_date.iso8601}", icon: "calendar-day", icon_style: :solid, sr_label: "Created #{dataset.created_at.to_date.iso8601}")
                      = semantic_badge(kind: :neutral, label: "ingested: #{dataset.curator_ingested_date&.iso8601 || 'N/A'}", icon: "calendar-day", icon_style: :solid, sr_label: "Ingested #{dataset.curator_ingested_date&.iso8601 || 'not available'}")
                      = semantic_badge(kind: :neutral, label: "released: #{dataset.release_date&.iso8601 || 'N/A'}", icon: "calendar-day", icon_style: :solid, sr_label: "Released #{dataset.release_date&.iso8601 || 'not available'}")
                      = semantic_badge(kind: :neutral, tone: "info", label: dataset.curator_visibility_label, icon: "eye", icon_style: :regular, sr_label: "Visibility #{dataset.curator_visibility_label}")
                      = semantic_badge(kind: :neutral, tone: "info", label: dataset.subject.presence || "Uncategorized", icon: "tag", icon_style: :solid, sr_label: "Subject #{dataset.subject.presence || 'Uncategorized'}")
                      = semantic_badge(kind: :neutral, label: pluralize(dataset.notes.size, "note"), icon: "note-sticky", icon_style: :regular, sr_label: "#{dataset.notes.size} notes")
                      - if dataset.version_request_pending?
                        = semantic_badge(kind: :status_alert, label: "version candidate under review", icon: "triangle-exclamation", icon_style: :solid, sr_label: "Version candidate under review")
                      - elsif dataset.version_request_approved?
                        = semantic_badge(kind: :status_alert, label: "pre-publication review", icon: "triangle-exclamation", icon_style: :solid, sr_label: "Pre-publication review")
                      - elsif dataset.version_eligible?
                        = semantic_badge(kind: :status_ok, label: "version candidate eligible to be submitted for pre-publication review", icon: "circle-check", icon_style: :solid, sr_label: "Version candidate eligible to be submitted for pre-publication review")
                      - if can?(:edit, dataset) && dataset.has_sharing_link? && !dataset.published?
                        = semantic_badge(kind: :status_ok, label: "has sharing link", icon: "link", icon_style: :solid, sr_label: "Has sharing link")
                      - if can?(:edit, dataset) && dataset.draft?
                        = semantic_badge(kind: :neutral, label: "draft", icon: "file", icon_style: :regular, sr_label: "Draft")

                  - if dataset.published? && dataset.published_at.present?
                    = semantic_badge(kind: :status_ok, tone: "primary", label: "published: #{dataset.published_at.to_date.iso8601}", icon: "calendar-check", icon_style: :solid, sr_label: "Published #{dataset.published_at.to_date.iso8601}")
                      
                  %h3.dataset-result-title= link_to dataset.title, dataset_path(dataset)
                  - if dataset.description.present?
                    - if dataset.description.length > 240
                      - preview = dataset.description[0, 240].rstrip
                      - remainder = dataset.description[240..]
                      %p.dataset-result-description{data: { controller: "description-toggle", description_toggle_more_label_value: "more description", description_toggle_less_label_value: "less description" }}
                        %span= "#{preview}..."
                        %span{data: { description_toggle_target: "remainder" }, hidden: true}= remainder
                        = button_tag "more description", type: "button", class: "dataset-description-toggle", data: { action: "description-toggle#toggle", description_toggle_target: "button" }, aria: { expanded: false }
                    - else
                      %p.dataset-result-description= dataset.description
                  .dataset-result-meta
                    - if dataset.subject.present?
                      %span Subject: #{dataset.subject}
                    - if dataset.keywords.present?
                      %span Keywords: #{dataset.keywords}
                    %span= dataset.key
          - else
            %p.no-results No datasets found.

    - if @total_pages > 1
      %nav.datasets-pagination{aria: { label: "Results pagination (bottom)" }}
        - if @page > 1
          = link_to "<", datasets_path(index_query_params(page: @page - 1)), class: "datasets-page-link", aria: { label: "Previous page" }
        - pagination_items.each do |item|
          - if item == :gap
            %span.datasets-page-ellipsis{aria: { hidden: true }} ...
          - elsif item == @page
            %span.datasets-page-current{aria: { current: "page" }}= item
          - else
            = link_to item, datasets_path(index_query_params(page: item)), class: "datasets-page-link", aria: { label: "Page #{item}" }
        - if @page < @total_pages
          = link_to ">", datasets_path(index_query_params(page: @page + 1)), class: "datasets-page-link", aria: { label: "Next page" }
