- content_for :title, "Datasets"

%ilw-page-title
  %h1{slot: "title"} Dataset Search

%ilw-content.datasets-search-page
  - if logged_in?
    %p.datasets-deposit-cta
      %a.ilw-button{href: new_dataset_path} Deposit a New Dataset

  = form_with url: datasets_path, method: :get, local: true, html: { id: "datasets-search-form", class: "datasets-search-form", role: "search", aria: { label: "Dataset search and filters" } } do |f|
    .datasets-toolbar
      .datasets-query-controls
        = f.label :q, "Search", class: "datasets-form-label"
        = f.search_field :q, value: @query, placeholder: "search for datasets", class: "datasets-search-input", aria: { label: "Search datasets" }
        .datasets-query-actions
          = f.submit "Apply Filters", class: "ilw-button"
          = link_to "Clear", datasets_path, class: "ilw-button datasets-clear-button", role: "button", aria: { label: "Clear all search filters" }

      - if @total_count.positive?
        - start_item = @search.offset_value + 1
        - end_item = [@search.offset_value + @datasets.length, @total_count].min
        %p.datasets-results-count{aria: { live: "polite" }}= "Displaying #{start_item} - #{end_item} of #{@total_count} in total"

      - if @total_pages > 1
        %nav.datasets-pagination.datasets-pagination-top{aria: { label: "Pagination" }}
          - if @page > 1
            = link_to "<", datasets_path(index_query_params(page: @page - 1)), class: "datasets-page-link", aria: { label: "Previous page" }
          - (1..@total_pages).each do |page_number|
            - if page_number == @page
              %span.datasets-page-current{aria: { current: "page" }}= page_number
            - else
              = link_to page_number, datasets_path(index_query_params(page: page_number)), class: "datasets-page-link", aria: { label: "Page #{page_number}" }
          - if @page < @total_pages
            = link_to ">", datasets_path(index_query_params(page: @page + 1)), class: "datasets-page-link", aria: { label: "Next page" }

      .datasets-per-page-control
        = f.label :per_page, "Results per page", class: "datasets-form-label"
        .datasets-per-page-inline
          = f.select :per_page, options_for_select(Search::DatasetSearch::PER_PAGE_OPTIONS.map { |value| ["#{value} per page", value] }, @per_page), {}, class: "datasets-select-input", aria: { label: "Results per page" }
          = f.submit "Go", class: "ilw-button datasets-go-button", aria: { label: "Apply results per page" }

    .datasets-search-layout
      %aside.datasets-filters-panel{aria: { label: "Filters" }}
        .datasets-filter-header
          %h2.datasets-section-heading Filters
          = link_to "Clear Filters", datasets_path(q: @query, per_page: @per_page), class: "ilw-button datasets-clear-filters"

        - if @available_facets.include?(:subjects)
          %fieldset.search-facet
            %legend.panel-title
              %h3.filter-heading Subject Area
            - @facet_options.fetch(:subjects, []).each do |row|
              - checked = Array(params[:subjects]).include?(row[:value])
              - subject_id = "subject_#{row[:value].to_s.parameterize}"
              .facet-row
                = check_box_tag "subjects[]", row[:value], checked, id: subject_id, class: "facet-checkbox"
                = label_tag subject_id, "#{row[:value]} (#{row[:count]})", class: "facet-label"

        - if @available_facets.include?(:funders)
          %fieldset.search-facet
            %legend.panel-title
              %h3.filter-heading Funder
            - @facet_options.fetch(:funders, []).each do |row|
              - checked = Array(params[:funders]).include?(row[:value])
              - funder_id = "funder_#{row[:value].to_s.parameterize}"
              .facet-row
                = check_box_tag "funders[]", row[:value], checked, id: funder_id, class: "facet-checkbox"
                = label_tag funder_id, "#{row.fetch(:label, row[:value])} (#{row[:count]})", class: "facet-label"

        - if @available_facets.include?(:publication_years)
          %fieldset.search-facet
            %legend.panel-title
              %h3.filter-heading Publication Year
            - @facet_options.fetch(:publication_years, []).each do |row|
              - value = row[:value].to_s
              - checked = Array(params[:publication_years]).include?(value)
              - year_id = "publication_year_#{value}"
              .facet-row
                = check_box_tag "publication_years[]", value, checked, id: year_id, class: "facet-checkbox"
                = label_tag year_id, "#{value} (#{row[:count]})", class: "facet-label"

        - if @available_facets.include?(:licenses)
          %fieldset.search-facet
            %legend.panel-title
              %h3.filter-heading License
            - @facet_options.fetch(:licenses, []).each do |row|
              - checked = Array(params[:licenses]).include?(row[:value])
              - license_id = "license_#{row[:value].to_s.parameterize}"
              .facet-row
                = check_box_tag "licenses[]", row[:value], checked, id: license_id, class: "facet-checkbox"
                = label_tag license_id, "#{row[:value]} (#{row[:count]})", class: "facet-label"

        - if @available_facets.include?(:publication_states)
          %fieldset.search-facet
            %legend.panel-title
              %h3.filter-heading Publication State
            - @facet_options.fetch(:publication_states, []).each do |row|
              - state_value = row[:value].to_s
              - checked = Array(params[:publication_states]).include?(state_value)
              - state_id = "publication_state_#{state_value.parameterize}"
              .facet-row
                = check_box_tag "publication_states[]", state_value, checked, id: state_id, class: "facet-checkbox"
                = label_tag state_id, "#{state_value.humanize} (#{row[:count]})", class: "facet-label"

        - if @available_facets.include?(:depositors)
          %fieldset.search-facet
            %legend.panel-title
              %h3.filter-heading Depositor
            - @facet_options.fetch(:depositors, []).each do |row|
              - checked = Array(params[:depositors]).include?(row[:value])
              - depositor_id = "depositor_#{row[:value].to_s.parameterize}"
              .facet-row
                = check_box_tag "depositors[]", row[:value], checked, id: depositor_id, class: "facet-checkbox"
                = label_tag depositor_id, "#{row[:label]} (#{row[:count]})", class: "facet-label"

      %section.datasets-results-panel{aria: { label: "Search results" }}
        %h2.datasets-section-heading Results

        - if @datasets.any?
          .datasets-results-list
            - @datasets.each do |dataset|
              %article.dataset-result-card
                - if dataset.published_at.present?
                  %p.dataset-result-published= "published: #{dataset.published_at.to_date}"
                %h3.dataset-result-title= link_to dataset.title, dataset_path(dataset)
                - if dataset.description.present?
                  - if dataset.description.length > 240
                    - preview = dataset.description[0, 240].rstrip
                    - remainder = dataset.description[240..]
                    %p.dataset-result-description{data: { controller: "description-toggle", description_toggle_more_label_value: "more description", description_toggle_less_label_value: "less description" }}
                      %span= "#{preview}..."
                      %span{data: { description_toggle_target: "remainder" }, hidden: true}= remainder
                      = button_tag "more description", type: "button", class: "dataset-description-toggle", data: { action: "description-toggle#toggle", description_toggle_target: "button" }, aria: { expanded: false }
                  - else
                    %p.dataset-result-description= dataset.description
                .dataset-result-meta
                  - if dataset.subject.present?
                    %span Subject: #{dataset.subject}
                  - if dataset.keywords.present?
                    %span Keywords: #{dataset.keywords}
                  %span= dataset.key
        - else
          %p.no-results No datasets found.

  - if @total_pages > 1
    %nav.datasets-pagination{aria: { label: "Pagination" }}
      - if @page > 1
        = link_to "<", datasets_path(index_query_params(page: @page - 1)), class: "datasets-page-link", aria: { label: "Previous page" }
      - (1..@total_pages).each do |page_number|
        - if page_number == @page
          %span.datasets-page-current{aria: { current: "page" }}= page_number
        - else
          = link_to page_number, datasets_path(index_query_params(page: page_number)), class: "datasets-page-link", aria: { label: "Page #{page_number}" }
      - if @page < @total_pages
        = link_to ">", datasets_path(index_query_params(page: @page + 1)), class: "datasets-page-link", aria: { label: "Next page" }
