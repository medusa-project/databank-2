- content_for :title, "Dataset Record Text"

%ilw-content.dataset-show-page
  %section.dataset-show-panel.idb-rounded-section{aria: { label: "Dataset record text" }}
    %h1.dataset-show-section-title Dataset Info File Preview
    = simple_format(@dataset.record_text)

    .idb-workflow-strip.idb-workflow-strip-bottom
      %nav.idb-workflow-actions-right{aria: { label: "Record text actions" }}
        = link_to "Back to Dataset", dataset_path(@dataset), class: "idb-button-secondary"
