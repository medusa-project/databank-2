- creator_mode_org = ActiveModel::Type::Boolean.new.cast(dataset.org_creators)
- default_creator_type = creator_mode_org ? Dataset::CREATOR_TYPE_INSTITUTION : Dataset::CREATOR_TYPE_PERSON
- dataset.creators.build(type_of: default_creator_type, row_position: 1) if dataset.creators.empty?
- orcid_lookup_enabled = dataset.persisted?
- orcid_lookup_url = orcid_lookup_enabled ? orcid_lookup_dataset_creators_path(dataset) : ""
- form_id = local_assigns[:form_id]
- form_html = { class: "idb-legacy-compact-form", data: { controller: "deposit-form", orcid_lookup_url: orcid_lookup_url } }
- form_html[:id] = form_id if form_id.present?

- if dataset.errors.any?
  %div.ilw-notice.ilw-notice--error
    %p Please fix the following errors:
    %ul
      - dataset.errors.full_messages.each do |message|
        %li= message

= form_with model: dataset, local: true, html: form_html do |f|
  = f.hidden_field :have_permission
  = f.hidden_field :removed_private
  = f.hidden_field :agree
  = f.hidden_field :org_creators, data: { deposit_form_target: "orgCreatorsField" }

  %section#dataset-core-metadata.idb-section-card
    %h2.idb-section-title Core Metadata
    %p
      %label{for: "citation-preview"} Citation Preview
      %span#citation-preview
        = dataset.creators.map(&:display_name).reject(&:blank?).join("; ").presence || "[Creator List]"
        = " "
        = "(#{Time.current.year}):"
        = " "
        = dataset.title.presence || "[The Title]."
        University of Illinois Urbana-Champaign.
    .idb-metadata-grid
      .idb-grid-col-6
        = f.label :title, "Dataset Title"
        = f.text_field :title, required: true

      .idb-grid-col-6
        = f.label :license
        = f.select :license, options_for_select([["CC0", "CC0"], ["CC BY 4.0", "CC-BY-4.0"], ["Other", "other"]], dataset.license), { include_blank: "Select..." }

      .idb-grid-col-12
        = f.label :description, "Dataset Description"
        = f.text_area :description, rows: 3

      .idb-grid-col-6
        = f.label :keywords, "Keywords"
        = f.text_field :keywords, placeholder: "semicolon separated list"

      .idb-grid-col-4
        = f.label :embargo, "Publication Delay (embargo)"
        = f.select :embargo, options_for_select([["No Publication Delay", "none"], ["File Only Publication Delay", "file"], ["Metadata and File Publication Delay", "metadata"]], dataset.embargo.presence || "none")

      .idb-grid-col-2
        = f.label :release_date, "Release Date"
        = f.date_field :release_date

      .idb-grid-col-6
        = f.label :subject
        = f.text_field :subject

      .idb-grid-col-6
        = f.label :publisher
        = f.text_field :publisher

      - if can?(:manage, dataset)
        .idb-grid-col-6
          = f.label :identifier, "Specified DOI"
          = f.text_field :identifier, placeholder: "Leave blank for auto-generate"

        .idb-grid-col-3.idb-grid-checkbox
          = f.check_box :is_import
          = f.label :is_import, "Imported DOI"

        .idb-grid-col-3.idb-grid-checkbox
          = f.check_box :is_test
          = f.label :is_test, "Test DOI"

        .idb-grid-col-2
          = f.label :dataset_version, "Version"
          = f.text_field :dataset_version

        .idb-grid-col-10
          = f.label :version_comment, "Version Comment"
          = f.text_area :version_comment, rows: 1

        .idb-grid-col-6
          = f.label :external_files_link, "Link to Externally Stored Files"
          = f.text_field :external_files_link, placeholder: "https://example.edu/path"

        .idb-grid-col-6
          = f.label :medusa_dataset_dir, "URL in Medusa"
          = f.text_field :medusa_dataset_dir, placeholder: "/cfs_directories/number"

        .idb-grid-col-12
          = f.label :external_files_note, "Access Notes for Externally Stored Files"
          = f.text_area :external_files_note, rows: 2

  %section#dataset-creators.idb-section-card
    %details.idb-section-disclosure{open: true, data: { deposit_form_target: "creatorDisclosure" }}
      %summary
        %h2.idb-section-title Creators
      .idb-section-body
        - if can?(:manage, dataset)
          %p
            %button.idb-button-secondary{type: "button", data: { action: "deposit-form#switchCreatorMode", mode: "person" }}
              Use Individual Creators
            = " "
            %button.idb-button-secondary{type: "button", data: { action: "deposit-form#switchCreatorMode", mode: "institution" }}
              Use Organization Creators
          %p
            %strong Curator note:
            Switching creator type deletes creator records of the other type and saves the form.

        - creators_for_mode = creator_mode_org ? dataset.institutional_creators : dataset.individual_creators
        - if creators_for_mode.empty?
          - dataset.creators.build(type_of: default_creator_type, row_position: 1)
          - creators_for_mode = creator_mode_org ? dataset.institutional_creators : dataset.individual_creators

        - if creator_mode_org
          %p One primary long-term contact must be selected from the organizational author list.

          %table.idb-compact-table.idb-compact-table-org
            %thead
              %tr
                %th
                  %span.sr-only Reorder
                %th Organization Name(s)
                %th Email
                %th Primary Contact
                %th
                  %span.sr-only Actions
            %tbody.idb-nested-rows{id: "creator-rows"}
              - creators_for_mode.each_with_index do |creator, index|
                = f.fields_for :creators, creator do |cf|
                  %tr.idb-nested-row{data: { deposit_form_target: "creatorRow" }}
                    %td.idb-drag-cell
                      %span{aria: { hidden: true }} ≡
                    %td
                      = cf.hidden_field :id if cf.object.persisted?
                      = cf.hidden_field :_destroy, value: false, data: { destroyField: true }
                      = cf.hidden_field :row_position, value: (cf.object.row_position || cf.object.position || (index + 1))
                      = cf.hidden_field :type_of, value: Dataset::CREATOR_TYPE_INSTITUTION, data: { creatorType: true }
                      = cf.hidden_field :contact, value: (creator.contact_selected? ? true : false), data: { contactField: true }
                      = cf.hidden_field :is_contact, value: (creator.contact_selected? ? true : false), data: { isContactField: true }
                      = cf.text_field :institution_name, value: (cf.object.institution_name.presence || cf.object.name), placeholder: "[Organization Name]"
                    %td
                      = cf.email_field :email, placeholder: "[e.g.: creator@institute.org]"
                    %td.idb-contact-cell
                      %input{type: "radio", name: "primary_contact_index", value: index, checked: creator.contact_selected?, aria: { label: "Primary Contact" }, data: { action: "change->deposit-form#syncPrimaryContact" }}
                    %td.idb-row-actions.idb-creator-row-actions
                      %button.idb-button-secondary.idb-compact-action{type: "button", title: "Move creator row up", aria: { label: "Move creator row up" }, data: { action: "deposit-form#moveRowUp" }} Up
                      %button.idb-button-secondary.idb-compact-action{type: "button", title: "Move creator row down", aria: { label: "Move creator row down" }, data: { action: "deposit-form#moveRowDown" }} Down
                      %button.idb-button-danger.idb-compact-action{type: "button", title: "Remove creator row", aria: { label: "Remove creator row" }, data: { action: "deposit-form#removeRow" }} Del
                      %button.idb-button-success.idb-compact-action.idb-add-creator-row{type: "button", title: "Add creator row", aria: { label: "Add creator row" }, data: { action: "deposit-form#addCreatorRow" }, hidden: index != creators_for_mode.length - 1} Add
        - else
          %p One primary long-term contact must be selected from the individual author list.

          %table.idb-compact-table.idb-compact-table-individual
            %thead
              %tr
                %th
                  %span.sr-only Reorder
                %th Family Name(s)
                %th Given Name(s)
                %th ORCID
                %th
                  %span.sr-only ORCID Lookup
                %th Email
                %th Primary Contact
                %th
                  %span.sr-only Actions
            %tbody.idb-nested-rows{id: "creator-rows"}
              - creators_for_mode.each_with_index do |creator, index|
                = f.fields_for :creators, creator do |cf|
                  %tr.idb-nested-row{data: { deposit_form_target: "creatorRow" }}
                    %td.idb-drag-cell
                      %span{aria: { hidden: true }} ≡
                    %td
                      = cf.hidden_field :id if cf.object.persisted?
                      = cf.hidden_field :_destroy, value: false, data: { destroyField: true }
                      = cf.hidden_field :row_position, value: (cf.object.row_position || cf.object.position || (index + 1))
                      = cf.hidden_field :type_of, value: Dataset::CREATOR_TYPE_PERSON, data: { creatorType: true }
                      = cf.hidden_field :contact, value: (creator.contact_selected? ? true : false), data: { contactField: true }
                      = cf.hidden_field :is_contact, value: (creator.contact_selected? ? true : false), data: { isContactField: true }
                      = cf.text_field :family_name, placeholder: "[e.g.: Smith]"
                    %td
                      = cf.text_field :given_name, placeholder: "[e.g.: Jean W.]"
                    %td
                      = cf.text_field :identifier, placeholder: "0000-0000-0000-0000", data: { orcidField: true }
                      = cf.hidden_field :identifier_scheme, value: "ORCID"
                    %td
                      %button.idb-button-secondary{type: "button", disabled: !orcid_lookup_enabled, data: { action: "deposit-form#openOrcidLookup" }} Look Up ORCID
                    %td
                      = cf.email_field :email, placeholder: "[e.g.: netid@illinois.edu]"
                    %td.idb-contact-cell
                      %input{type: "radio", name: "primary_contact_index", value: index, checked: creator.contact_selected?, aria: { label: "Primary Contact" }, data: { action: "change->deposit-form#syncPrimaryContact" }}
                    %td.idb-row-actions.idb-creator-row-actions
                      %button.idb-button-secondary.idb-compact-action{type: "button", title: "Move creator row up", aria: { label: "Move creator row up" }, data: { action: "deposit-form#moveRowUp" }} Up
                      %button.idb-button-secondary.idb-compact-action{type: "button", title: "Move creator row down", aria: { label: "Move creator row down" }, data: { action: "deposit-form#moveRowDown" }} Down
                      %button.idb-button-danger.idb-compact-action{type: "button", title: "Remove creator row", aria: { label: "Remove creator row" }, data: { action: "deposit-form#removeRow" }} Del
                      %button.idb-button-success.idb-compact-action.idb-add-creator-row{type: "button", title: "Add creator row", aria: { label: "Add creator row" }, data: { action: "deposit-form#addCreatorRow" }, hidden: index != creators_for_mode.length - 1} Add

  %section#dataset-funders.idb-section-card
    %details.idb-section-disclosure{open: dataset.funders.any? ? true : nil}
      %summary
        %h2.idb-section-title Funders
      .idb-section-body
        .idb-nested-rows{id: "funder-rows"}
          - dataset.funders.each_with_index do |funder, index|
            = f.fields_for :funders, funder do |ff|
              .idb-nested-row
                = ff.hidden_field :id if ff.object.persisted?
                = ff.hidden_field :_destroy, value: false, data: { destroyField: true }
                = ff.hidden_field :row_position, value: (ff.object.row_position || ff.object.position || (index + 1))
                .idb-nested-grid
                  .idb-grid-col-3
                    = ff.label :code, "Funder Code"
                    = ff.text_field :code, list: "known-funders"
                  .idb-grid-col-4
                    = ff.label :name, "Funder Name"
                    = ff.text_field :name
                  .idb-grid-col-4
                    = ff.label :grant, "Grant Number"
                    = ff.text_field :grant
                  .idb-grid-col-1.idb-row-actions-inline
                    %button.idb-button-danger{type: "button", aria: { label: "Remove funder row" }, data: { action: "deposit-form#removeRow" }} Remove
                    %button.idb-button-secondary{type: "button", aria: { label: "Move funder row up" }, data: { action: "deposit-form#moveRowUp" }} Up
                    %button.idb-button-secondary{type: "button", aria: { label: "Move funder row down" }, data: { action: "deposit-form#moveRowDown" }} Down
                = ff.hidden_field :identifier
                = ff.hidden_field :identifier_scheme

        %p
          %button.idb-button-secondary{type: "button", data: { action: "deposit-form#addFunderRow" }} Add Funder

        %datalist#known-funders
          - FunderCatalog.known_entries.each do |entry|
            %option{value: entry.name}= entry.identifier

  %section#dataset-related-materials.idb-section-card
    %details.idb-section-disclosure{open: dataset.related_materials.any? ? true : nil}
      %summary
        %h2.idb-section-title Related Materials
      .idb-section-body
        .idb-nested-rows{id: "material-rows"}
          - dataset.related_materials.each_with_index do |material, index|
            = f.fields_for :related_materials, material do |mf|
              .idb-nested-row{data: { deposit_form_target: "materialRow" }}
                = mf.hidden_field :id if mf.object.persisted?
                = mf.hidden_field :_destroy, value: false, data: { destroyField: true }
                = mf.hidden_field :row_position, value: (mf.object.row_position || mf.object.position || (index + 1))
                = mf.hidden_field :datacite_list, data: { dataciteListField: true }
                .idb-nested-grid
                  .idb-grid-col-2
                    = mf.label :selected_type, "Related Resource Type"
                    = mf.select :selected_type, options_for_select(["Article", "Code", "Dataset", "Presentation", "Thesis", "Other"], mf.object.selected_type), { include_blank: "Select..." }, { data: { action: "change->deposit-form#materialTypeChanged" } }
                  .idb-grid-col-2
                    = mf.label :material_type, "Material Type"
                    = mf.text_field :material_type, data: { materialTypeField: true }
                  .idb-grid-col-3
                    = mf.label :link, "Resource URL"
                    = mf.text_field :link
                  .idb-grid-col-4
                    = mf.label :citation
                    = mf.text_area :citation, rows: 2
                  .idb-grid-col-1.idb-row-actions-inline
                    %button.idb-button-danger{type: "button", aria: { label: "Remove related material row" }, data: { action: "deposit-form#removeRow" }} Remove
                    %button.idb-button-secondary{type: "button", aria: { label: "Move related material row up" }, data: { action: "deposit-form#moveRowUp" }} Up
                    %button.idb-button-secondary{type: "button", aria: { label: "Move related material row down" }, data: { action: "deposit-form#moveRowDown" }} Down

                - if can?(:manage, dataset)
                  %fieldset.idb-grid-fieldset
                    %legend DataCite Relationships (Curator)
                    .idb-nested-grid
                      .idb-grid-col-5
                        - ["IsSupplementTo", "IsSupplementedBy", "IsCitedBy", "IsPreviousVersionOf", "IsNewVersionOf"].each do |relationship|
                          %label
                            %input{type: "checkbox", value: relationship, checked: mf.object.datacite_list.to_s.split(",").map(&:strip).include?(relationship), data: { action: "change->deposit-form#syncDataciteList", dataciteCheck: true }}
                            = relationship
                      .idb-grid-col-2
                        = mf.label :uri_type
                        = mf.text_field :uri_type
                      .idb-grid-col-3
                        = mf.label :uri
                        = mf.text_field :uri
                      .idb-grid-col-2
                        = mf.label :note
                        = mf.text_field :note

        %p
          %button.idb-button-secondary{type: "button", data: { action: "deposit-form#addMaterialRow" }} Add Related Material

  %p
    = f.submit submit_label, class: "idb-button-primary", id: "update-confirm"

  %template{data: { deposit_form_target: "creatorTemplate" }}
    - if creator_mode_org
      = f.fields_for :creators, Creator.new(type_of: Dataset::CREATOR_TYPE_INSTITUTION), child_index: "NEW_CREATOR" do |cf|
        %tr.idb-nested-row{data: { deposit_form_target: "creatorRow" }}
          %td.idb-drag-cell
            %span{aria: { hidden: true }} ≡
          %td
            = cf.hidden_field :_destroy, value: false, data: { destroyField: true }
            = cf.hidden_field :row_position, value: 999
            = cf.hidden_field :type_of, value: Dataset::CREATOR_TYPE_INSTITUTION, data: { creatorType: true }
            = cf.hidden_field :contact, value: false, data: { contactField: true }
            = cf.hidden_field :is_contact, value: false, data: { isContactField: true }
            = cf.text_field :institution_name, placeholder: "[Organization Name]"
          %td
            = cf.email_field :email, placeholder: "[e.g.: creator@institute.org]"
          %td.idb-contact-cell
            %input{type: "radio", name: "primary_contact_index", value: "NEW_CREATOR", aria: { label: "Primary Contact" }, data: { action: "change->deposit-form#syncPrimaryContact" }}
          %td.idb-row-actions.idb-creator-row-actions
            %button.idb-button-secondary.idb-compact-action{type: "button", title: "Move creator row up", aria: { label: "Move creator row up" }, data: { action: "deposit-form#moveRowUp" }} Up
            %button.idb-button-secondary.idb-compact-action{type: "button", title: "Move creator row down", aria: { label: "Move creator row down" }, data: { action: "deposit-form#moveRowDown" }} Down
            %button.idb-button-danger.idb-compact-action{type: "button", title: "Remove creator row", aria: { label: "Remove creator row" }, data: { action: "deposit-form#removeRow" }} Del
            %button.idb-button-success.idb-compact-action.idb-add-creator-row{type: "button", title: "Add creator row", aria: { label: "Add creator row" }, data: { action: "deposit-form#addCreatorRow" }, hidden: true} Add
    - else
      = f.fields_for :creators, Creator.new(type_of: Dataset::CREATOR_TYPE_PERSON), child_index: "NEW_CREATOR" do |cf|
        %tr.idb-nested-row{data: { deposit_form_target: "creatorRow" }}
          %td.idb-drag-cell
            %span{aria: { hidden: true }} ≡
          %td
            = cf.hidden_field :_destroy, value: false, data: { destroyField: true }
            = cf.hidden_field :row_position, value: 999
            = cf.hidden_field :type_of, value: Dataset::CREATOR_TYPE_PERSON, data: { creatorType: true }
            = cf.hidden_field :contact, value: false, data: { contactField: true }
            = cf.hidden_field :is_contact, value: false, data: { isContactField: true }
            = cf.text_field :family_name, placeholder: "[e.g.: Smith]"
          %td
            = cf.text_field :given_name, placeholder: "[e.g.: Jean W.]"
          %td
            = cf.text_field :identifier, placeholder: "0000-0000-0000-0000", data: { orcidField: true }
            = cf.hidden_field :identifier_scheme, value: "ORCID"
          %td
            %button.idb-button-secondary{type: "button", disabled: !orcid_lookup_enabled, data: { action: "deposit-form#openOrcidLookup" }} Look Up ORCID
          %td
            = cf.email_field :email, placeholder: "[e.g.: netid@illinois.edu]"
          %td.idb-contact-cell
            %input{type: "radio", name: "primary_contact_index", value: "NEW_CREATOR", aria: { label: "Primary Contact" }, data: { action: "change->deposit-form#syncPrimaryContact" }}
          %td.idb-row-actions.idb-creator-row-actions
            %button.idb-button-secondary.idb-compact-action{type: "button", title: "Move creator row up", aria: { label: "Move creator row up" }, data: { action: "deposit-form#moveRowUp" }} Up
            %button.idb-button-secondary.idb-compact-action{type: "button", title: "Move creator row down", aria: { label: "Move creator row down" }, data: { action: "deposit-form#moveRowDown" }} Down
            %button.idb-button-danger.idb-compact-action{type: "button", title: "Remove creator row", aria: { label: "Remove creator row" }, data: { action: "deposit-form#removeRow" }} Del
            %button.idb-button-success.idb-compact-action.idb-add-creator-row{type: "button", title: "Add creator row", aria: { label: "Add creator row" }, data: { action: "deposit-form#addCreatorRow" }, hidden: true} Add

  %template{data: { deposit_form_target: "funderTemplate" }}
    = f.fields_for :funders, Funder.new, child_index: "NEW_FUNDER" do |ff|
      .idb-nested-row
        = ff.hidden_field :_destroy, value: false, data: { destroyField: true }
        = ff.hidden_field :row_position, value: 999
        .idb-nested-grid
          .idb-grid-col-3
            = ff.label :code, "Funder Code"
            = ff.text_field :code, list: "known-funders"
          .idb-grid-col-4
            = ff.label :name, "Funder Name"
            = ff.text_field :name
          .idb-grid-col-4
            = ff.label :grant, "Grant Number"
            = ff.text_field :grant
          .idb-grid-col-1.idb-row-actions-inline
            %button.idb-button-danger{type: "button", aria: { label: "Remove funder row" }, data: { action: "deposit-form#removeRow" }} Remove
            %button.idb-button-secondary{type: "button", aria: { label: "Move funder row up" }, data: { action: "deposit-form#moveRowUp" }} Up
            %button.idb-button-secondary{type: "button", aria: { label: "Move funder row down" }, data: { action: "deposit-form#moveRowDown" }} Down
        = ff.hidden_field :identifier
        = ff.hidden_field :identifier_scheme

  %template{data: { deposit_form_target: "materialTemplate" }}
    = f.fields_for :related_materials, RelatedMaterial.new, child_index: "NEW_MATERIAL" do |mf|
      .idb-nested-row{data: { deposit_form_target: "materialRow" }}
        = mf.hidden_field :_destroy, value: false, data: { destroyField: true }
        = mf.hidden_field :row_position, value: 999
        = mf.hidden_field :datacite_list, data: { dataciteListField: true }
        .idb-nested-grid
          .idb-grid-col-2
            = mf.label :selected_type, "Related Resource Type"
            = mf.select :selected_type, options_for_select(["Article", "Code", "Dataset", "Presentation", "Thesis", "Other"]), { include_blank: "Select..." }, { data: { action: "change->deposit-form#materialTypeChanged" } }
          .idb-grid-col-2
            = mf.label :material_type, "Material Type"
            = mf.text_field :material_type, data: { materialTypeField: true }
          .idb-grid-col-3
            = mf.label :link, "Resource URL"
            = mf.text_field :link
          .idb-grid-col-4
            = mf.label :citation
            = mf.text_area :citation, rows: 2
          .idb-grid-col-1.idb-row-actions-inline
            %button.idb-button-danger{type: "button", aria: { label: "Remove related material row" }, data: { action: "deposit-form#removeRow" }} Remove
            %button.idb-button-secondary{type: "button", aria: { label: "Move related material row up" }, data: { action: "deposit-form#moveRowUp" }} Up
            %button.idb-button-secondary{type: "button", aria: { label: "Move related material row down" }, data: { action: "deposit-form#moveRowDown" }} Down
        - if can?(:manage, dataset)
          %fieldset.idb-grid-fieldset
            %legend DataCite Relationships (Curator)
            .idb-nested-grid
              .idb-grid-col-5
                - ["IsSupplementTo", "IsSupplementedBy", "IsCitedBy", "IsPreviousVersionOf", "IsNewVersionOf"].each do |relationship|
                  %label
                    %input{type: "checkbox", value: relationship, data: { action: "change->deposit-form#syncDataciteList", dataciteCheck: true }}
                    = relationship
              .idb-grid-col-2
                = mf.label :uri_type
                = mf.text_field :uri_type
              .idb-grid-col-3
                = mf.label :uri
                = mf.text_field :uri
              .idb-grid-col-2
                = mf.label :note
                = mf.text_field :note

  %dialog#orcid-lookup-dialog{aria: { labelledby: "orcid-lookup-title", describedby: "orcid-lookup-help" }, data: { deposit_form_target: "orcidDialog", action: "cancel->deposit-form#onOrcidDialogCancel close->deposit-form#onOrcidDialogClose" }}
    .idb-orcid-modal
      .idb-orcid-modal-header
        %h3#orcid-lookup-title ORCID Lookup
        %p#orcid-lookup-help Search by family and/or given name.
      .idb-orcid-modal-body
        .idb-orcid-modal-fields
          .idb-orcid-field
            %label{for: "orcid-family-name"} Family Name
            %input#orcid-family-name{type: "text", data: { deposit_form_target: "orcidFamilyName" }}
          .idb-orcid-field
            %label{for: "orcid-given-name"} Given Name
            %input#orcid-given-name{type: "text", data: { deposit_form_target: "orcidGivenName" }}
          .idb-orcid-field-actions
            %button.idb-button-primary{type: "button", data: { action: "deposit-form#searchOrcid" }} Search
        .idb-orcid-results{aria: { live: "polite" }, data: { deposit_form_target: "orcidResults" }}
      .idb-orcid-modal-footer
        %button.idb-button-danger{type: "button", data: { action: "deposit-form#closeOrcidLookup" }} Cancel
        = " "
        %button.idb-button-success{type: "button", data: { action: "deposit-form#applyOrcidSelection" }} Apply Selected ORCID
