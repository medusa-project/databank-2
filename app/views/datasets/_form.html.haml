- if dataset.errors.any?
  %div.ilw-notice.ilw-notice--error
    %p Please fix the following errors:
    %ul
      - dataset.errors.full_messages.each do |message|
        %li= message

= form_with model: dataset, local: true do |f|
  %p
    = f.label :title
    %br/
    = f.text_field :title, required: true

  %p
    = f.label :description
    %br/
    = f.text_area :description, rows: 6

  %p
    = f.label :keywords, "Keywords (comma-separated)"
    %br/
    = f.text_field :keywords

  %p
    = f.label :subject
    %br/
    = f.text_field :subject

  %p
    = f.label :license
    %br/
    = f.text_field :license

  %p
    = f.label :publisher
    %br/
    = f.text_field :publisher

  %p
    = f.submit submit_label, class: "ilw-button"
