<header>
%il-header{slot: "header"}
  %a{slot: "site-name", href: root_path} Illinois Data Bank
  %a{slot: "primary-unit", href: "https://www.library.illinois.edu/rds/"} Research Data Service
  %nav{slot: "links", "aria-label": "Utility"}
    %ul
      - if logged_in?
        %li
          %a.utility-link-user{href: "/datasets?editor=#{current_user.username}"}= current_user.name
        %li
          = link_to "Log out", logout_path, method: :delete, class: "utility-link-logout"
      - else
        %li
          %a.utility-link-welcome{href: "/"} Welcome
        %li
          %a.utility-link-login{href: "/login"} Log in
  %il-header-nav{slot: "navigation"}
    %ul
      %li
        %a{href: pre_deposit_datasets_path} Deposit Dataset
      %li
        %a{href: datasets_path} Find Data
      %li
        %a{href: policies_path} Policies
      %li
        %a{href: guides_path} Guides
      %li
        %a{href: contact_path} Contact Us
</header>
