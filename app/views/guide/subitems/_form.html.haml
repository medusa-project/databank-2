= form_with model: @guide_subitem, class: "guide-cms-form" do |f|
  - if @guide_subitem.errors.any?
    .ilw-notice.ilw-notice--error{role: "alert"}
      %h2= "#{pluralize(@guide_subitem.errors.count, 'error')} prevented this subitem from being saved"
      %ul
        - @guide_subitem.errors.full_messages.each do |msg|
          %li= msg

  .idb-metadata-grid
    .idb-grid-col-6
      = f.label :item_id, "Parent Item"
      = f.collection_select :item_id, @guide_items, :id, :label, { prompt: "Select item" }, class: "form-control", required: true
    .idb-grid-col-6
      = f.label :label, "Label"
      = f.text_field :label, class: "form-control", required: true
    .idb-grid-col-6
      = f.label :anchor, "Anchor"
      = f.text_field :anchor, class: "form-control", required: true
    .idb-grid-col-4
      = f.label :ordinal, "Display Order"
      = f.number_field :ordinal, class: "form-control", min: 1
    .idb-grid-col-8
      = f.label :heading, "Heading"
      = f.text_field :heading, class: "form-control"
    .idb-grid-col-12
      .checkbox
        %label
          = f.check_box :public
          Publicly visible
    .idb-grid-col-12
      = f.label :body, "Body"
      = f.rich_text_area :body, aria: { label: "Body" }

  .idb-row-actions
    = f.submit "Save Subitem", class: "btn btn-primary idb"
    = link_to "Cancel", guide_subitems_path, class: "btn btn-default idb"
