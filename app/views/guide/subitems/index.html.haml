- content_for :title, "Guide Subitems"
- content_for :include_actiontext_css, true

%ilw-content
  .idb-section-card
    %h2.idb-section-title Guide CMS
    %p Manage third-level guide subitems.
    %p
      = link_to "Manage Sections", guide_sections_path, class: "btn btn-default idb"
      = link_to "Manage Items", guide_items_path, class: "btn btn-default idb"
      = link_to "Manage Subitems", guide_subitems_path, class: "btn btn-primary idb"

  .idb-section-card
    .idb-row-actions
      = link_to "New Subitem", new_guide_subitem_path, class: "btn btn-success idb"

    %table.table.table-striped.table-bordered
      %caption.sr-only Guide subitems list
      %thead
        %tr
          %th Section
          %th Item
          %th Label
          %th Anchor
          %th Order
          %th Public
          %th Actions
      %tbody
        - @guide_subitems.each do |subitem|
          %tr
            %td= subitem.guide_item&.guide_section&.label || "(missing section)"
            %td= subitem.guide_item&.label || "(missing item)"
            %td= subitem.label
            %td= subitem.anchor
            %td= subitem.ordinal
            %td= subitem.public? ? "Yes" : "No"
            %td
              = link_to "Edit", edit_guide_subitem_path(subitem), class: "btn btn-info btn-sm idb"
              = link_to "Delete", guide_subitem_path(subitem), method: :delete, data: { confirm: "Delete this subitem?" }, class: "btn btn-danger btn-sm idb"
