- content_for :title, "Curator Metrics"
- modified_times = @modified_times || {}
- refresh_status = @refresh_status || {}
- metric_definitions = @metric_definitions || []

%ilw-content.dataset-show-page
  %section.dataset-show-panel.idb-rounded-section{aria: { label: "Metrics exports" }}
    %h1.dataset-show-section-title Curator Metrics

    %p
      = link_to "Metrics Dashboard", "/metrics", class: "idb-button-primary"

    - if metric_definitions.empty?
      %p.idb-workflow-note No metric exports are currently configured.

    %ul.dataset-show-list
      - metric_definitions.each do |definition|
        - metric_key = definition.key
        - refresh_in_progress = refresh_status[metric_key]
        - is_json_metric = definition.content_type == "application/json"
        - download_filename = File.basename(definition.download_path.to_s)
        %li{data: {testid: "metric-card-#{metric_key}"}}
          %h3.metric-header
            = definition.label
            - if !refresh_in_progress && definition.download_path.present?
              = semantic_action_button(action: :download, url: definition.download_path, icon_only: true, aria_label: "Download #{definition.label}", title: "Download #{definition.label}", data: {testid: "metric-download-#{metric_key}"}, download: (is_json_metric ? download_filename : nil))

          %div.dataset-show-list-secondary.inline-block
            Modified:
            = modified_times[metric_key].presence || "not found"

            - if current_user&.admin? && definition.refreshable?
              - if refresh_in_progress
                %span.metric-status-inline{data: {testid: "metric-refresh-status-#{metric_key}"}}
                  = semantic_status_badge(status: "in_progress", label: "refresh in progress", sr_label: "Refresh in progress")
                  Refresh in progress
              - else
                = button_to "Regenerate #{definition.label}", refresh_path_for(metric_key), method: :post,
                            form_class: "inline-block",
                            data: {testid: "metric-refresh-#{metric_key}"}

          - if definition.summary.present?
            %span.dataset-show-list-tertiary= definition.summary

          - if refresh_in_progress
            %p.idb-workflow-note
              Please refresh this page manually to check status.

          - description_blocks = definition.description_blocks || []
          - if description_blocks.any?
            .dataset-show-list-tertiary
              - description_blocks.each do |block|
                %p= block

          - columns = definition.columns || []
          - if columns.any?
            .dataset-show-list-tertiary
              %strong Field definitions
              %ul
                - columns.each do |column|
                  - column_name = column[:name] || column["name"]
                  - column_description = column[:description] || column["description"]
                  %li
                    %strong= "#{column_name}:"
                    = column_description

    %section{aria: { label: "Datafiles listing" }}
      %h2.dataset-show-section-subtitle Datafiles listing
      %p
        = link_to "Datafiles listing JSON", "/metrics/datafiles_simple_list.json", class: "idb-button-secondary"
