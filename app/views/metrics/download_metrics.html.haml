  .metrics-zip-actions.download-metrics-zip-actions
    = semantic_action_button(action: :download, label: "Download All Calendar Year CSVs (zip)", url: metrics_download_zip_path(group: :datafile_calendar), aria_label: "Download all datafile calendar year CSVs as zip", style: :legacy, icon_position: :right, class: "btn-sm idb")
    = semantic_action_button(action: :download, label: "Download All Fiscal Year CSVs (zip)", url: metrics_download_zip_path(group: :datafile_fiscal), aria_label: "Download all datafile fiscal year CSVs as zip", style: :legacy, icon_position: :right, class: "btn-sm idb")

