- content_for :title, (@featured_researcher.name.present? ? "Edit #{@featured_researcher.name}" : "Edit Researcher Spotlight")

%ilw-content.featured-researchers-page
  .idb-section-card
    %h2.idb-section-title Edit Researcher Spotlight
    = render "form"

    .idb-row-actions
      = link_to "Delete", featured_researcher_path(@featured_researcher), method: :delete, data: { confirm: "Are you sure?" }, class: "idb-button-danger"
