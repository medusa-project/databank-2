- content_for :title, (@featured_researcher.name.present? ? "Edit #{@featured_researcher.name}" : "Edit Researcher Spotlight")

%ilw-content.featured-researchers-page
  .idb-section-card
    %h2.idb-section-title Edit Researcher Spotlight
    = render "form"

    .idb-row-actions
      = semantic_action_button(action: :preview, url: preview_featured_researcher_path(@featured_researcher), style: :idb)
      = semantic_action_button(action: :delete, url: featured_researcher_path(@featured_researcher), style: :idb, method: :delete, data: { confirm: "Are you sure?" })  