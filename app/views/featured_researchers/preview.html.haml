- content_for :title, (@featured_researcher.name.presence || "Researcher Spotlight Preview")

%ilw-content.featured-researchers-page
  .idb-section-card
    %h2.idb-section-title Researcher Spotlight Preview
    = render "individual", featured_researcher: @featured_researcher

    .idb-row-actions
      = semantic_action_button(action: :preview, url: featured_researchers_path, style: :idb, label: "List Researcher Spotlights")
      
