- content_for :title, (@featured_researcher.name.presence || "Researcher Spotlight")

%ilw-content.featured-researchers-page
  .idb-section-card
    %h2.idb-section-title Researcher Spotlight
    = render "individual", featured_researcher: @featured_researcher

    .idb-row-actions
      = semantic_action_button(action: :secondary, label: "Back to Spotlights", url: researcher_spotlights_path, style: :idb)
