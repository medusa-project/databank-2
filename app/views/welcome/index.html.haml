- content_for :title, "Illinois Data Bank"
- content_for :hide_page_title, true

%section#welcome-image{style: "background-image: url('#{asset_path('orange_data_banner_2021-08-05.png')}')"}
  #welcome-overlay
    %ul.list-unstyled
      %li.welcome-item
        The
        %h1.welcome-title Illinois Data Bank
        is a public access repository for publishing research data from the University of Illinois Urbana-Champaign.
      %li.welcome-item
        %a{href: "/guides#desirable_characteristics"} Learn how we meet trustworthy repository standards

%section#welcome-body
  .welcome-primary-row
    .welcome-main
      %h2 You are ready to deposit data if:
      %ul
        %li Your data is in a final state and not expected to undergo revisions.
        %li You have removed any private, confidential, or legally protected information.
        %li You are a faculty member, staff member, or graduate student at the University of Illinois Urbana-Champaign.
        %li You have permission to publicly distribute data from all creators and copyright owners.

      %h2 Published data:
      %ul
        %li Is open to anyone in the world.
        %li Receives a stable DOI for easy reference and citation.
        %li Is readily available for a minimum of 5 years.
        %li Is stored in a stable environment that complies with funder and publisher requirements.

    .welcome-spotlight
      %h2 Researcher Spotlight
      - if @featured_researcher.present?
        .featured-bio
          - if @featured_researcher.photo_url.present?
            .photo-preview
              %img{src: @featured_researcher.photo_url,
                   class: "img-responsive",
                   alt: "Headshot of #{@featured_researcher.name}"}
          %strong= @featured_researcher.name
          - if @featured_researcher.bio.present?
            .featured-rich-text= spotlight_rich_text(@featured_researcher.bio)

        .featured-buttons
          - if @featured_researcher.dataset_url.present?
            = external_https_link_to "dataset", @featured_researcher.dataset_url, class: "idb-button-primary", target: "_blank", rel: "noopener", aria: { label: "dataset provided by #{@featured_researcher.name}" }
          - if @featured_researcher.article_url.present?
            = external_https_link_to "article", @featured_researcher.article_url, class: "idb-button-primary", target: "_blank", rel: "noopener", aria: { label: "article provided by #{@featured_researcher.name}" }

        - if @featured_researcher.question.present? || @featured_researcher.testimonial.present?
          .featured-comment
            - if @featured_researcher.question.present?
              %strong= @featured_researcher.question
            - if @featured_researcher.testimonial.present?
              .elbow.featured-rich-text= spotlight_rich_text(@featured_researcher.testimonial)

        %hr
        %p
          = link_to "See all researcher spotlights", researcher_spotlights_path, class: "idb-button-default welcome-spotlight-all"
      - else
        %p
          The Illinois Data Bank features researchers who deposit data. Check back soon for our next spotlight.
        %hr
        %p
          = link_to "See all researcher spotlights", researcher_spotlights_path, class: "idb-button-default welcome-spotlight-all"

  - if logged_in? && (current_user.admin? || current_user.curator?)
    .welcome-staff-row
      - if current_user.admin?
        .welcome-main
          %h2 Curator and Admin Tools
          %p
            = link_to "Curator and Admin Page", admin_path, class: "idb-button-primary"
      - else
        = render "role_switch_form"
