- if Rails.env.development? || Rails.env.test?
  = form_with url: role_switch_path, method: :post, local: true, class: "welcome-role-switch-form" do |f|
    %label{for: "welcome-role-switch", class: "sr-only"} Change role
    = f.select :role, options_for_select(["depositor", "curator", "admin"], current_user.role), id: "welcome-role-switch", class: "welcome-role-switch-select"
    = f.submit "Switch role", class: "idb-button-secondary"
- else
  %p Role switching is available only in development and test environments.
