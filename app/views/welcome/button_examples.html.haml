- content_for :title, "Button Examples"

%ilw-content.button-examples-page
  %section{ "aria-labelledby" => "button-examples-heading" }
    %h1#button-examples-heading Button Examples
    %p This temporary page demonstrates each available button style.

  %section{ "aria-labelledby" => "button-examples-standard" }
    %h2#button-examples-standard Standard Buttons
    %p
      These now use the legacy effective palette from legacy Data Bank overrides:
      primary
      %code #265191
      , success
      %code #488222
      , info
      %code #B34700
      , danger
      %code #C02C2C
      , warning
      %code #F47F24
      with
      %code #252525
      text for AA contrast.
    %p
      %button.idb-button-primary{ type: "button" } Primary Button
    %p
      %button.idb-button-secondary{ type: "button" } Secondary Button
    %p
      %button.idb-button-danger{ type: "button" } Danger Button
    %p
      %button.idb-button-success{ type: "button" } Success Button
    %p
      %button.idb-button-info{ type: "button" } Info Button
    %p
      %button.idb-button-warning{ type: "button" } Warning Button (dark text for contrast)
    %p
      %button.idb-button-default{ type: "button" } Default Button
    %p
      %a.idb-button-link{ href: "#" } Link Button

  %section{ "aria-labelledby" => "button-examples-additional" }
    %h2#button-examples-additional Additional Toolkit Button Examples
    %p These temporary samples are distinct from the current named variants.
    %p
      %button.idb-button-primary.idb-button-demo-one{ type: "button" } One
    %p
      %button.idb-button-primary.idb-button-demo-two{ type: "button" } Two
    %p
      %button.idb-button-primary.idb-button-demo-three{ type: "button" } Three
    %p
      %button.idb-button-primary.idb-button-demo-four{ type: "button" } Four
    %p
      %button.idb-button-primary.idb-button-demo-five{ type: "button" } Five

  %section{ "aria-labelledby" => "button-examples-legacy-effective" }
    %h2#button-examples-legacy-effective Legacy Effective Button Styling
    %p
      These samples reproduce the effective legacy app button styling (including override colors from legacy stylesheet rules).
      They intentionally use the legacy palette values from the old app's final button overrides.
    %p
      %button.legacy-btn.legacy-btn-primary{ type: "button" } Save & Continue
    %p
      %button.legacy-btn.legacy-btn-info{ type: "button" } Save & Exit
    %p
      %button.legacy-btn.legacy-btn-success{ type: "button" } Edit
    %p
      %button.legacy-btn.legacy-btn-danger{ type: "button" } Delete
    %p
      %button.legacy-btn.legacy-btn-warning{ type: "button" } Warning
    %p
      %button.legacy-btn.legacy-btn-share{ type: "button" } Generate private sharing link
    %p
      %button.legacy-btn.legacy-btn-default{ type: "button" } Default

    %h3 Legacy Effective Anchor Variants
    %p
      %a.legacy-btn.legacy-btn-primary{ href: "#" } Primary Link
    %p
      %a.legacy-btn.legacy-btn-info{ href: "#" } Info Link
    %p
      %a.legacy-btn.legacy-btn-success{ href: "#" } Success Link
    %p
      %a.legacy-btn.legacy-btn-danger{ href: "#" } Danger Link
    %p
      %a.legacy-btn.legacy-btn-share{ href: "#" } Share Link
    %p
      %a.legacy-btn.legacy-btn-default{ href: "#" } Default Link

  %section{ "aria-labelledby" => "button-examples-anchor" }
    %h2#button-examples-anchor Anchor Button Variants
    %p
      %a.idb-button-primary{ href: "#" } Primary Link Button
    %p
      %a.idb-button-secondary{ href: "#" } Secondary Link Button
    %p
      %a.idb-button-danger{ href: "#" } Danger Link Button
    %p
      %a.idb-button-success{ href: "#" } Success Link Button
    %p
      %a.idb-button-info{ href: "#" } Info Link Button
    %p
      %a.idb-button-warning{ href: "#" } Warning Link Button
    %p
      %a.idb-button-default{ href: "#" } Default Link Button

  %section{ "aria-labelledby" => "button-examples-native" }
    %h2#button-examples-native Native Button Elements
    %p
      %button{ type: "button" } Native Button
    %p
      %input{ type: "submit", value: "Native Submit" }
    %p
      %input{ type: "button", value: "Native Input Button" }
