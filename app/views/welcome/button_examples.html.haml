- content_for :title, "Button Examples"

%ilw-content.button-examples-page
  %section{ "aria-labelledby" => "button-examples-heading" }
    %h1#button-examples-heading Button Examples
    %p
      This page shows the legacy effective button styling currently selected for databank-2,
      followed by semantic helper examples with icons.

  %section{ "aria-labelledby" => "button-examples-legacy-effective" }
    %h2#button-examples-legacy-effective Legacy Effective Button Styling
    %p
      These samples reproduce the effective legacy app button styling (including override colors from legacy stylesheet rules).
      They intentionally use the legacy palette values from the old app's final button overrides.
    %p
      %button.legacy-btn.legacy-btn-primary{ type: "button" } Save & Continue
    %p
      %button.legacy-btn.legacy-btn-info{ type: "button" } Save & Exit
    %p
      %button.legacy-btn.legacy-btn-success{ type: "button" } Edit
    %p
      %button.legacy-btn.legacy-btn-danger{ type: "button" } Delete
    %p
      %button.legacy-btn.legacy-btn-warning{ type: "button" } Warning
    %p
      %button.legacy-btn.legacy-btn-share{ type: "button" } Generate private sharing link
    %p
      %button.legacy-btn.legacy-btn-default{ type: "button" } Default

    %h3 IDB Neutral Variants
    %p
      %button.idb-button-secondary{ type: "button" } Secondary
    %p
      %button.idb-button-default{ type: "button" } Default

    %h3 Legacy Effective Anchor Variants
    %p
      %a.legacy-btn.legacy-btn-primary{ href: "#" } Primary Link
    %p
      %a.legacy-btn.legacy-btn-info{ href: "#" } Info Link
    %p
      %a.legacy-btn.legacy-btn-success{ href: "#" } Success Link
    %p
      %a.legacy-btn.legacy-btn-danger{ href: "#" } Danger Link
    %p
      %a.legacy-btn.legacy-btn-share{ href: "#" } Share Link
    %p
      %a.legacy-btn.legacy-btn-default{ href: "#" } Default Link

    %h3 Legacy disabled state
    %p
      %button.legacy-btn.legacy-btn-primary{ type: "button", disabled: true } Disabled Primary
    %p
      %button.legacy-btn.legacy-btn-info{ type: "button", disabled: true } Disabled Info
    %p
      %button.legacy-btn.legacy-btn-success{ type: "button", disabled: true } Disabled Success
    %p
      %button.legacy-btn.legacy-btn-danger{ type: "button", disabled: true } Disabled Danger
    %p
      %button.legacy-btn.legacy-btn-warning{ type: "button", disabled: true } Disabled Warning
    %p
      %button.idb-button-secondary{ type: "button", disabled: true } Disabled Secondary
    %p
      %button.idb-button-default{ type: "button", disabled: true } Disabled Default


  %section{ "aria-labelledby" => "button-examples-semantic" }
    %h2#button-examples-semantic Semantic Helper Buttons (Legacy Style + Icons)
    %p
      These samples use
      %code semantic_action_button
      from
      %code ApplicationHelper
      to keep icon, style, and accessibility behavior consistent.
    %h3 Text + Icon Buttons
    %p
      = semantic_action_button(action: :save, style: :legacy)
    %p
      = semantic_action_button(action: :edit, style: :legacy)
    %p
      = semantic_action_button(action: :search, style: :legacy)
    %p
      = semantic_action_button(action: :preview, style: :idb)
    %p
      = semantic_action_button(action: :continue, style: :legacy)
    %p
      = semantic_action_button(action: :publish, style: :legacy)

    %h3 Icon-Only Buttons (aria-label)
    %p
      = semantic_action_button(action: :save, style: :legacy, icon_only: true, aria_label: "Save changes")
    %p
      = semantic_action_button(action: :edit, style: :legacy, icon_only: true, aria_label: "Edit item")
    %p
      = semantic_action_button(action: :search, style: :legacy, icon_only: true, aria_label: "Search")
    %p
      = semantic_action_button(action: :preview, style: :idb, icon_only: true, aria_label: "Preview")
    %p
      = semantic_action_button(action: :continue, style: :legacy, icon_only: true, aria_label: "Continue to next step")
    %p
      = semantic_action_button(action: :publish, style: :legacy, icon_only: true, aria_label: "Publish dataset")

    %h3 Link Variants Using the Same Semantics
    %p
      = semantic_action_button(action: :save, style: :legacy, url: "#")
    %p
      = semantic_action_button(action: :edit, style: :legacy, url: "#")
    %p
      = semantic_action_button(action: :search, style: :legacy, url: "#")
    %p
      = semantic_action_button(action: :preview, style: :idb, url: "#")
    %p
      = semantic_action_button(action: :continue, style: :legacy, url: "#")
    %p
      = semantic_action_button(action: :publish, style: :legacy, url: "#")
    %p
      = semantic_action_button(action: :dataset, style: :legacy, url: "#")
    %p
      = semantic_action_button(action: :article, style: :legacy, url: "#")

    %h3 Icon Position Examples
    %p
      = semantic_action_button(action: :search, style: :legacy, icon_position: :left)
    %p
      = semantic_action_button(action: :continue, style: :legacy, icon_position: :right)

  %section{ "aria-labelledby" => "button-examples-native" }
    %h2#button-examples-native Native Element Reference
    %p
      %button{ type: "button" } Native Button
    %p
      %input{ type: "submit", value: "Native Submit" }
    %p
      %input{ type: "button", value: "Native Input Button" }

