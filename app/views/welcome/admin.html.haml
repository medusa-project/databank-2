- content_for :title, "Curator and Admin Page"

- if current_user&.admin?
  %section.idb-section-card
    %h2.idb-section-title Administrative Controls
    %p
      = link_to "Manage Researcher Spotlights", featured_researchers_path, class: "idb-button-primary"
    %p
      = link_to "External Delivery Audit", admin_external_delivery_attempts_path, class: "idb-button-primary"
    %p
      = button_to "Clear Rails Cache", clear_admin_cache_path, method: :post, class: "idb-button-danger", form: { data: { turbo_confirm: "Clear the Rails cache?" } }

  %section.idb-section-card
    %h2.idb-section-title Manage Service Message
    = form_with url: update_admin_system_message_path, method: :patch, scope: :admin_page, local: true do |f|
      %div
        = f.label :system_message, "Service message"
        = f.text_area :system_message, value: @system_message_for_form, rows: 3
      %p
        = f.submit "Save Message", class: "idb-button-primary"

  %section.idb-section-card
    %h2.idb-section-title Manage Curators
    %h3.idb-section-title Core Curators (Encrypted Config)
    - if @core_curator_emails.any?
      %ul
        - @core_curator_emails.each do |email|
          %li= email
    - else
      %p No core curators configured.

    %h3.idb-section-title Admin-Managed Curators
    = form_with url: admin_managed_curators_path, method: :post, scope: :managed_curator, local: true do |f|
      %div
        = f.label :email, "Curator email"
        = f.email_field :email, required: true, autocomplete: "email"
      %p
        = f.submit "Add Curator", class: "idb-button-primary"

    - if @managed_curators.any?
      %table.idb-compact-table
        %thead
          %tr
            %th Email
            %th Actions
        %tbody
          - @managed_curators.each do |managed_curator|
            %tr
              %td= managed_curator.email
              %td
                = button_to "Remove", admin_managed_curator_path(managed_curator), method: :delete, class: "idb-button-danger", form: { data: { turbo_confirm: "Remove #{managed_curator.email} from admin-managed curators?" } }
    - else
      %p No admin-managed curators configured.

  %section.idb-section-card
    %h2.idb-section-title Manage Deposit Exceptions
    %p
      Add users who should be allowed to deposit even when authentication assigns them a no-deposit role.

    = form_with url: admin_managed_deposit_exceptions_path, method: :post, scope: :managed_deposit_exception, local: true do |f|
      %div
        = f.label :email, "Deposit exception email"
        = f.email_field :email, required: true, autocomplete: "email"
      %p
        = f.submit "Add Deposit Exception", class: "idb-button-primary"

    - if @managed_deposit_exceptions.any?
      %table.idb-compact-table
        %thead
          %tr
            %th Email
            %th Actions
        %tbody
          - @managed_deposit_exceptions.each do |managed_exception|
            %tr
              %td= managed_exception.email
              %td
                = button_to "Remove", admin_managed_deposit_exception_path(managed_exception), method: :delete, class: "idb-button-danger", form: { data: { turbo_confirm: "Remove #{managed_exception.email} from admin-managed deposit exceptions?" } }
    - else
      %p No admin-managed deposit exceptions configured.

  %section.idb-section-card
    %h2.idb-section-title File Audit Report
    %p Generate a CSV audit of all dataset files and storage status.
    = form_with url: request_file_audit_curator_reports_path, method: :post, local: true do |f|
      .idb-form-row
        = f.label :notes, "Request notes (optional)"
        = f.text_area :notes, rows: 3
      .idb-workflow-strip
        %nav.idb-workflow-actions-right{aria: { label: "File audit report actions" }}
          = f.submit "Request File Audit Report", class: "idb-button-primary"
          = link_to "See All Curator Reports", curator_reports_path, class: "idb-button-secondary"

  .idb-workflow-strip.idb-workflow-strip-bottom
    %nav.idb-workflow-actions-right{aria: { label: "Admin page actions" }}
      = link_to "Back", root_path, class: "idb-button-secondary"
- else
  %h2 You are not authorized to view this page.
  .idb-workflow-strip.idb-workflow-strip-bottom
    %nav.idb-workflow-actions-right{aria: { label: "Unauthorized actions" }}
      = link_to "Back", root_path, class: "idb-button-secondary"
